<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ACTIVITÉS DU JOUR"
            android:textColor="#78D6C6"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_count"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/count_badge"
            android:gravity="center"
            android:text="0"
            android:textColor="#071D25"
            android:textSize="14sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/widget_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@android:color/transparent"
            android:contentDescription="Actualiser"
            android:padding="8dp"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#B5C9CE" />
        <ImageButton
            android:id="@+id/widget_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="Filtres"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#B5C9CE" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:id="@+id/widget_row1_dot" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginTop="5dp" android:layout_marginEnd="8dp" android:src="@drawable/dot_en_cours" android:contentDescription="Statut" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_row1_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_row1_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#91AAB0" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:id="@+id/widget_row2_dot" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginTop="5dp" android:layout_marginEnd="8dp" android:src="@drawable/dot_en_cours" android:contentDescription="Statut" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_row2_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_row2_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#91AAB0" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:id="@+id/widget_row3_dot" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginTop="5dp" android:layout_marginEnd="8dp" android:src="@drawable/dot_en_cours" android:contentDescription="Statut" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_row3_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_row3_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#91AAB0" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:id="@+id/widget_row4_dot" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginTop="5dp" android:layout_marginEnd="8dp" android:src="@drawable/dot_en_cours" android:contentDescription="Statut" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_row4_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_row4_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#91AAB0" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:id="@+id/widget_row5_dot" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginTop="5dp" android:layout_marginEnd="8dp" android:src="@drawable/dot_en_cours" android:contentDescription="Statut" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_row5_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_row5_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#91AAB0" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Aucune activité aujourd’hui"
        android:textColor="#91AAB0"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="" />

    <TextView
        android:id="@+id/widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Voir tout"
        android:textColor="#78D6C6"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
