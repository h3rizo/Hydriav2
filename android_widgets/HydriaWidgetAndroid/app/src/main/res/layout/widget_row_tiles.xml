<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/tile_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#1AFFFFFF"
        android:padding="8dp"
        android:layout_margin="2dp">
        <TextView android:id="@+id/value_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFD27A" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/label_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#CCFFFFFF" android:textSize="10sp" />
        <TextView android:id="@+id/amount_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#B9F3DF" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tile_right"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#1AFFFFFF"
        android:padding="8dp"
        android:layout_margin="2dp">
        <TextView android:id="@+id/value_right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFD27A" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/label_right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#CCFFFFFF" android:textSize="10sp" />
        <TextView android:id="@+id/amount_right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#B9F3DF" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
