<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0141C2C"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💧 Hydria"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="7dp"
            android:text="↻"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:contentDescription="Actualiser" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tous les périmètres"
        android:textColor="#B3FFFFFF"
        android:textSize="9sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/widget_diamex_import"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dernière importation DiameX : inconnue"
        android:textColor="#B9F3DF"
        android:textSize="9sp"
        android:paddingBottom="4dp" />

    <!-- Liste défilante : un RemoteViews ne peut défiler qu'avec une collection (alimentée par HydriaWidgetService). -->
    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:fadeScrollbars="false"
        android:scrollbarSize="4dp"
        android:overScrollMode="never" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#99FFFFFF"
        android:textSize="9sp"
        android:paddingTop="4dp"
        android:gravity="end" />

</LinearLayout>
