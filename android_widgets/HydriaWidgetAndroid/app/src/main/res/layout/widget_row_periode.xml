<?xml version="1.0" encoding="utf-8"?>
<!-- Titre de la section « Fait … » + sélecteur de période J / S / M (chaque lettre est tapable). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="9dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/periode_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#99FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView android:id="@+id/periode_jour" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="J" android:textSize="11sp" android:textStyle="bold" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginStart="2dp" />
    <TextView android:id="@+id/periode_semaine" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="S" android:textSize="11sp" android:textStyle="bold" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginStart="2dp" />
    <TextView android:id="@+id/periode_mois" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="M" android:textSize="11sp" android:textStyle="bold" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginStart="2dp" />
</LinearLayout>
