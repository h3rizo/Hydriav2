<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RÉPARATIONS · CETTE SEMAINE"
            android:textColor="#78D6C6"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_unseen"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/unseen_badge"
            android:gravity="center"
            android:text="0"
            android:textColor="#071D25"
            android:textSize="14sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/widget_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@android:color/transparent"
            android:contentDescription="Actualiser"
            android:padding="8dp"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#B5C9CE"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:layout_marginTop="8dp"
        android:contentDescription="Photo de la réparation"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Actualisation…"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_ouvrage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#D7E4E7"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_employee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#91AAB0"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#789198"
        android:textSize="11sp" />

    <TextView
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="" />

    <Button
        android:id="@+id/widget_seen"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="9dp"
        android:backgroundTint="#78D6C6"
        android:text="J’AI VU · SUIVANT"
        android:textColor="#071D25"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
