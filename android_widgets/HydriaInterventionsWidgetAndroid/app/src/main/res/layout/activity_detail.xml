<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/detail_unseen" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="— non vue" android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold" />
            <ImageButton android:id="@+id/detail_refresh" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:contentDescription="Actualiser" android:src="@android:drawable/ic_popup_sync" app:tint="@color/text_secondary" />
        </LinearLayout>
        <ProgressBar android:id="@+id/detail_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" />
        <TextView android:id="@+id/detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Chargement…" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/detail_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="4dp" android:textColor="@color/text_secondary" android:textSize="15sp" />
        <TextView android:id="@+id/detail_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/note_background" android:padding="16dp" android:textColor="@color/text_primary" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="PHOTOS" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/detail_gallery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
        <Button android:id="@+id/detail_seen" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:layout_marginBottom="24dp" android:backgroundTint="@color/accent" android:text="J’AI VU · AFFICHER LA SUIVANTE" android:textColor="#071D25" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
