<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Hydria · Analyse consommation"
        android:theme="@style/Theme.HydriaWidget"
        android:supportsRtl="true">

        <!--
            Activité de configuration : Android l'affiche automatiquement
            à l'ajout du widget sur l'écran d'accueil (intent-filter
            APPWIDGET_CONFIGURE requis pour que le système la reconnaisse
            comme telle, cf. android:configure dans hydria_widget_info.xml).
        -->
        <activity
            android:name=".ConfigActivity"
            android:exported="true"
            android:label="Connexion Hydria">
            <!-- Permet d'ouvrir l'application après une installation ADB/Studio.
                 Sans activité launcher, le paquet peut rester stopped=true et
                 certains lanceurs masquent alors son AppWidgetProvider. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
            Écran de détail (District → Commune, ou liste plate) ouvert
            au tap sur une tuile de stat du widget. exported="false" :
            uniquement lancée depuis HydriaWidgetProvider, pas depuis
            l'extérieur de l'app.
        -->
        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:label="Détail" />

        <receiver
            android:name=".HydriaWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="mg.hydria.widget.consommation.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hydria_widget_info" />
        </receiver>

    </application>

</manifest>
