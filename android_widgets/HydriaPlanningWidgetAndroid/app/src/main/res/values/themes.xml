<resources>
    <style name="Theme.HydriaPlanningWidget" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#78D6C6</item>
        <item name="colorPrimaryVariant">#4BAA9C</item>
        <item name="colorSecondary">#78D6C6</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">#071D25</item>
        <item name="android:statusBarColor">#071D25</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Une case de la grille calendaire : jour + compteur combines en une
         seule TextView (Spannable construit dans PlanningWidgetProvider),
         pour rester sous la limite de vues RemoteViews d'un AppWidget.
         android:layout_* (width/height/margin/columnWeight/rowWeight/gravity)
         ne peuvent pas etre portes par un style -> restent sur chaque
         <TextView> dans planning_widget.xml. -->
    <style name="CalCell">
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">10sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:background">@drawable/cal_cell_background</item>
    </style>

    <!-- Une ligne d'agenda : puce de statut + titre + sous-titre combines
         en une seule TextView (meme raison que CalCell ci-dessus). -->
    <style name="AgendaRow">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
    </style>
</resources>
