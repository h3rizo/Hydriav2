<?xml version="1.0" encoding="utf-8"?>
<!--
    CRITICAL : depuis Android 12, un widget dont le RemoteViews depasse un
    certain nombre de vues n'est pas construit ("Impossible de charger ce
    widget" / le bouton "Ajouter a l'ecran d'accueil" ne repond plus). La
    version precedente (1 LinearLayout + 2 TextView par case x 42 + 1
    LinearLayout par ligne d'agenda x 4) approchait les 180 vues. Ici :
    - la grille utilise un GridLayout (7 colonnes, auto-flow) avec UNE SEULE
      TextView par case (jour + compteur combines via Spannable dans le
      code, pas deux TextView separees) ;
    - chaque ligne d'agenda est une UNE SEULE TextView (puce couleur +
      titre + sous-titre combines via Spannable, pas de sous-vues).
    Total ~= 1 (racine) + 5 (en-tete) + 4 (nav mois) + 8 (jours semaine)
    + 1 (grille) + 42 (cases) + 1 (separateur) + 1 (bloc agenda) + 1 (entete
    agenda) + 4 (lignes agenda) + 3 (vide/spacer/voir tout) = 71 vues.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PLANNING" android:textColor="#78D6C6" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_count" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/count_badge" android:gravity="center" android:text="0" android:textColor="#071D25" android:textSize="12sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/widget_refresh" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="4dp" android:background="@android:color/transparent" android:contentDescription="Actualiser" android:padding="7dp" android:src="@android:drawable/ic_popup_sync" android:tint="#B5C9CE" />
        <ImageButton android:id="@+id/widget_settings" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="2dp" android:background="@android:color/transparent" android:contentDescription="Filtres" android:padding="7dp" android:src="@android:drawable/ic_menu_preferences" android:tint="#B5C9CE" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/widget_prev" android:layout_width="28dp" android:layout_height="28dp" android:background="@android:color/transparent" android:contentDescription="Mois précédent" android:src="@android:drawable/ic_media_previous" android:tint="#B5C9CE" />
        <TextView android:id="@+id/widget_month_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/widget_next" android:layout_width="28dp" android:layout_height="28dp" android:background="@android:color/transparent" android:contentDescription="Mois suivant" android:src="@android:drawable/ic_media_next" android:tint="#B5C9CE" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="L" android:textColor="#91AAB0" android:textSize="8.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="M" android:textColor="#91AAB0" android:textSize="8.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="M" android:textColor="#91AAB0" android:textSize="8.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="J" android:textColor="#91AAB0" android:textSize="8.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="V" android:textColor="#91AAB0" android:textSize="8.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="#91AAB0" android:textSize="8.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="D" android:textColor="#91AAB0" android:textSize="8.5sp" />
    </LinearLayout>

    <!-- Grille calendaire : LinearLayout classique (poids), 6 lignes de 7
         cases. Une seule TextView par case (jour + compteur combines via
         Spannable dans le code), au lieu des 3 vues (conteneur+jour+badge)
         de la premiere version. Le mecanisme LinearLayout/poids est celui
         deja eprouve par l'ancien widget Calendrier qui fonctionnait. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3" android:layout_marginTop="2dp" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/cal_cell_0" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_1" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_2" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_3" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_4" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_5" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_6" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/cal_cell_7" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_8" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_9" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_10" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_11" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_12" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_13" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/cal_cell_14" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_15" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_16" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_17" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_18" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_19" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_20" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/cal_cell_21" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_22" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_23" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_24" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_25" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_26" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_27" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/cal_cell_28" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_29" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_30" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_31" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_32" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_33" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_34" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/cal_cell_35" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_36" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_37" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_38" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_39" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_40" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
            <TextView android:id="@+id/cal_cell_41" style="@style/CalCell" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Separateur -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:background="#1FFFFFFF" />

    <!-- Agenda du jour selectionne (aujourd'hui par defaut), poids 2. Chaque
         ligne = une seule TextView (puce + titre + sous-titre combines via
         Spannable dans le code), pas de sous-vues. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" android:orientation="vertical">

        <TextView android:id="@+id/agenda_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AUJOURD’HUI" android:textColor="#78D6C6" android:textSize="9.5sp" android:textStyle="bold" android:letterSpacing="0.04" />

        <TextView android:id="@+id/agenda_row1" style="@style/AgendaRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:visibility="gone" />
        <TextView android:id="@+id/agenda_row2" style="@style/AgendaRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
        <TextView android:id="@+id/agenda_row3" style="@style/AgendaRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
        <TextView android:id="@+id/agenda_row4" style="@style/AgendaRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />

        <TextView android:id="@+id/agenda_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Aucune activité" android:textColor="#91AAB0" android:textSize="11sp" android:visibility="gone" />

        <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:text="" />

        <TextView android:id="@+id/agenda_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Voir tout" android:textColor="#78D6C6" android:textSize="10.5sp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
