<?xml version="1.0" encoding="utf-8"?>
<!--
  Police téléchargeable via le fournisseur Google Fonts (aucun .ttf à embarquer).
  Déclarer aussi archivo_semibold / archivo_bold sur le même modèle en changant
  android:fontProviderQuery, et roboto_mono.xml pour les chiffres.
  Prérequis : ajouter <meta-data android:name="preloaded_fonts" .../> si vous
  voulez précharger, sinon rien de plus.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:fontProviderAuthority="com.google.android.gms.fonts"
    app:fontProviderPackage="com.google.android.gms"
    app:fontProviderQuery="name=Archivo&amp;weight=400"
    app:fontProviderCerts="@array/com_google_android_gms_fonts_certs" />
