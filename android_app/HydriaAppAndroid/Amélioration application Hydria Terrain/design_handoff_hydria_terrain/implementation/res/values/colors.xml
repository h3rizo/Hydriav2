<?xml version="1.0" encoding="utf-8"?>
<!--
  Hydria Terrain — palette MODE CLAIR (values/).
  Le mode sombre vit dans values-night/colors.xml avec les MÊMES noms.
  Les anciens noms (hydria_background, hydria_cyan…) sont conservés pour ne rien
  casser dans MainActivity.kt ; les valeurs sont recalculées pour le plein soleil.
-->
<resources>
    <!-- Fonds -->
    <color name="hydria_background_deep">#FFFFFF</color>
    <color name="hydria_background">#F4F7F8</color>
    <color name="hydria_surface">#FFFFFF</color>
    <color name="hydria_surface_raised">#F4F9FA</color>
    <color name="hydria_outline">#D2E0E4</color>
    <color name="hydria_outline_soft">#E2EBEE</color>

    <!-- Texte -->
    <color name="hydria_text">#07151D</color>
    <color name="hydria_text_secondary">#4A6570</color>
    <color name="hydria_text_muted">#7A929B</color>

    <!-- Accents : contraste ≥ 4,5:1 sur hydria_surface -->
    <color name="hydria_cyan">#0E7E90</color>
    <color name="hydria_cyan_strong">#0A5F6E</color>
    <color name="hydria_cyan_wash">#E6F3F5</color>
    <color name="hydria_vase">#C96F10</color>
    <color name="hydria_vase_wash">#FBEEDE</color>

    <!-- États -->
    <color name="hydria_success">#1E8A56</color>
    <color name="hydria_success_wash">#F0F7F3</color>
    <color name="hydria_warning">#A86A10</color>
    <color name="hydria_warning_wash">#FDF3E3</color>
    <color name="hydria_error">#C0392B</color>
    <color name="hydria_error_wash">#FBEDED</color>

    <!-- Texte posé SUR un accent plein -->
    <color name="hydria_on_accent">#FFFFFF</color>
    <color name="hydria_ink">#07151D</color>

    <!-- Catégories cartographiques (identiques dans les deux modes) -->
    <color name="hydria_map_village">#6C5BD4</color>
    <color name="hydria_map_point">#0E7E90</color>
    <color name="hydria_map_equipment">#C96F10</color>
    <color name="hydria_map_landmark">#1E8A56</color>

    <color name="ic_launcher_background">#0A1D27</color>
</resources>
