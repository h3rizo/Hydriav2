<?xml version="1.0" encoding="utf-8"?>
<!-- Hydria Terrain — échelle de cibles, rayons et espacements (direction « Lisible au soleil »). -->
<resources>
    <!-- Cibles tactiles : minimum 48dp, 56 pour une action de formulaire, 64 pour l'action principale -->
    <dimen name="hydria_target_min">48dp</dimen>
    <dimen name="hydria_target_row">68dp</dimen>
    <dimen name="hydria_target_form">56dp</dimen>
    <dimen name="hydria_target_primary">64dp</dimen>
    <dimen name="hydria_target_nav">74dp</dimen>

    <!-- Rayons : moins bombés que la v2.3 (18/22dp) -->
    <dimen name="hydria_radius_card">16dp</dimen>
    <dimen name="hydria_radius_row">14dp</dimen>
    <dimen name="hydria_radius_field">14dp</dimen>
    <dimen name="hydria_radius_button">16dp</dimen>
    <dimen name="hydria_radius_pill">19dp</dimen>
    <dimen name="hydria_radius_sheet">26dp</dimen>

    <!-- Filet de criticité en bord gauche de carte -->
    <dimen name="hydria_accent_bar">3dp</dimen>
    <dimen name="hydria_hairline">1dp</dimen>

    <!-- Espacements -->
    <dimen name="hydria_gutter">18dp</dimen>
    <dimen name="hydria_gap">8dp</dimen>
    <dimen name="hydria_gap_section">14dp</dimen>
    <dimen name="hydria_card_padding">16dp</dimen>

    <!-- Colonne du chiffre principal dans les lignes de tâche -->
    <dimen name="hydria_numeral_column">44dp</dimen>

    <!-- Échelle typographique (sp) -->
    <dimen name="hydria_text_display">44sp</dimen>
    <dimen name="hydria_text_title">19sp</dimen>
    <dimen name="hydria_text_card_title">16sp</dimen>
    <dimen name="hydria_text_row_title">15sp</dimen>
    <dimen name="hydria_text_body">13sp</dimen>
    <dimen name="hydria_text_meta">12sp</dimen>
    <dimen name="hydria_text_overline">11sp</dimen>
    <dimen name="hydria_text_numeral_row">24sp</dimen>
</resources>
