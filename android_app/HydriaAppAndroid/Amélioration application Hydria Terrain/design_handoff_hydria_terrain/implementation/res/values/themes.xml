<?xml version="1.0" encoding="utf-8"?>
<!--
  Le thème devient DayNight : plus aucune couleur en dur ici, tout vient de
  values/colors.xml et values-night/colors.xml.
  Dans Application.onCreate() : AppCompatDelegate.setDefaultNightMode(MODE_NIGHT_FOLLOW_SYSTEM)
  pour le « sombre + clair auto ».
-->
<resources>
    <style name="Theme.HydriaApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hydria_cyan</item>
        <item name="colorPrimaryVariant">@color/hydria_cyan_strong</item>
        <item name="colorSecondary">@color/hydria_vase</item>
        <item name="colorAccent">@color/hydria_cyan</item>
        <item name="colorSurface">@color/hydria_surface</item>
        <item name="colorOnPrimary">@color/hydria_on_accent</item>
        <item name="colorOnSecondary">@color/hydria_on_accent</item>
        <item name="colorOnSurface">@color/hydria_text</item>
        <item name="android:windowBackground">@color/hydria_background</item>
        <item name="android:navigationBarColor">@color/hydria_background_deep</item>
        <item name="android:statusBarColor">@color/hydria_background_deep</item>
        <!-- Suit le mode : icônes sombres sur fond clair -->
        <item name="android:windowLightStatusBar">@bool/hydria_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/hydria_light_system_bars</item>
        <item name="android:fontFamily">@font/archivo</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Hydria.Dialog</item>
    </style>

    <style name="ThemeOverlay.Hydria.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/hydria_surface_raised</item>
        <item name="colorOnSurface">@color/hydria_text</item>
        <item name="colorPrimary">@color/hydria_cyan</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>
</resources>
