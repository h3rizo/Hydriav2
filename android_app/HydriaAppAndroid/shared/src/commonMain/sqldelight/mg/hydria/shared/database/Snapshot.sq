-- Miroir de snapshot_chunks (TerrainDatabase.kt, app/) : le snapshot JSON du
-- prechargement offline est trop volumineux pour une seule ligne SQLite sur
-- certains appareils (limite CursorWindow), donc decoupe en chunks ordonnes.
-- Pas encore branchee sur l'app (Phase 2 du plan de migration KMP).

CREATE TABLE snapshotChunks (
    chunkIndex INTEGER NOT NULL PRIMARY KEY,
    payload TEXT NOT NULL,
    updatedAt INTEGER NOT NULL
);

selectAllOrdered:
SELECT payload
FROM snapshotChunks
ORDER BY chunkIndex ASC;

insertChunk:
INSERT INTO snapshotChunks(chunkIndex, payload, updatedAt)
VALUES (?, ?, ?);

deleteAll:
DELETE FROM snapshotChunks;
