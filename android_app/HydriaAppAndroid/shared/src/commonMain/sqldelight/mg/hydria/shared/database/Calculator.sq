-- Miroir de calculator_state + salary_calculation_config (TerrainDatabase.kt,
-- app/) : memoire de saisie de la calculatrice de salaire et cache local des
-- baremes serveur actifs. Pas encore branchee sur l'app (Phase 2 du plan de
-- migration KMP).

CREATE TABLE calculatorState (
    accountKey TEXT NOT NULL PRIMARY KEY,
    payload TEXT NOT NULL,
    updatedAt INTEGER NOT NULL
);

upsertState:
INSERT OR REPLACE INTO calculatorState(accountKey, payload, updatedAt)
VALUES (?, ?, ?);

selectState:
SELECT payload
FROM calculatorState
WHERE accountKey = ?;

deleteState:
DELETE FROM calculatorState WHERE accountKey = ?;

CREATE TABLE salaryCalculationConfig (
    accountKey TEXT NOT NULL,
    organisationKey TEXT NOT NULL,
    formulaVersion INTEGER NOT NULL,
    configVersion TEXT NOT NULL,
    checksum TEXT NOT NULL,
    payload TEXT NOT NULL,
    effectiveFrom TEXT,
    effectiveTo TEXT,
    serverUpdatedAt TEXT NOT NULL,
    syncedAt INTEGER NOT NULL,
    isActive INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(accountKey, organisationKey, configVersion)
);

CREATE INDEX idx_salary_config_active ON salaryCalculationConfig(accountKey, organisationKey, isActive);

deactivateAll:
UPDATE salaryCalculationConfig SET isActive = 0 WHERE accountKey = ? AND organisationKey = ?;

insertConfig:
INSERT INTO salaryCalculationConfig(
    accountKey, organisationKey, formulaVersion, configVersion, checksum,
    payload, effectiveFrom, effectiveTo, serverUpdatedAt, syncedAt, isActive
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1);

selectActiveConfig:
SELECT payload, syncedAt
FROM salaryCalculationConfig
WHERE accountKey = ? AND organisationKey = ? AND isActive = 1
ORDER BY serverUpdatedAt DESC LIMIT 1;
