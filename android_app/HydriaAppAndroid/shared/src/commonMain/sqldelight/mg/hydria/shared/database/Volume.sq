-- Miroir de volume_cache (TerrainDatabase.kt, app/) : cache cle-valeur
-- generique par compte, utilise par VolumeRepository (app/) pour les packs
-- de factures volumetriques, les recapitulatifs et l'historique d'audit
-- ("audit:*"). Pas encore branchee sur l'app (Phase 2 du plan de migration
-- KMP) : l'orchestration (savePack, reconciliation d'audit) reste dans
-- VolumeRepository, qui compose ces primitives read/write/history.

CREATE TABLE volumeCache (
    account TEXT NOT NULL,
    cacheKey TEXT NOT NULL,
    payload TEXT NOT NULL,
    PRIMARY KEY(account, cacheKey)
);

upsert:
INSERT OR REPLACE INTO volumeCache(account, cacheKey, payload)
VALUES (?, ?, ?);

selectPayload:
SELECT payload
FROM volumeCache
WHERE account = ? AND cacheKey = ?;

selectAuditHistory:
SELECT payload
FROM volumeCache
WHERE account = ? AND cacheKey LIKE 'audit:%'
ORDER BY rowid DESC LIMIT 200;
