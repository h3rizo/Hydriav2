-- Miroir de search_cache (TerrainDatabase.kt, app/) : cache des resultats de
-- recherche pour consultation hors ligne. Pas encore branchee sur l'app
-- (Phase 2 du plan de migration KMP).

CREATE TABLE searchCache (
    cacheKey TEXT NOT NULL PRIMARY KEY,
    payload TEXT NOT NULL,
    updatedAt INTEGER NOT NULL
);

CREATE INDEX idx_search_cache_updated ON searchCache(updatedAt);

upsert:
INSERT OR REPLACE INTO searchCache(cacheKey, payload, updatedAt)
VALUES (?, ?, ?);

selectPayload:
SELECT payload
FROM searchCache
WHERE cacheKey = ?;

selectUpdatedAt:
SELECT updatedAt
FROM searchCache
WHERE cacheKey = ?;
