<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Le site utilise la geolocalisation navigateur (capture GPS
         terrain, voir CLAUDE.md "captureGPSPosition") — necessaire pour
         que la WebView puisse relayer ces demandes au GPS du telephone. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Rappels de pointage GPS : notification locale + reprogrammation apres redemarrage -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Upload de photos (inspections, reparations avec preuves photo) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Telechargement de fichiers generes par le site (exports Excel,
         factures PDF, etc.) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".HydriaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.HydriaApp"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <activity android:name=".volume.VolumeActivity" android:exported="false" />

        <activity
            android:name=".calculator.AdvancedCalculatorActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".search.SearchDetailActivity"
            android:exported="false" />

        <activity
            android:name=".search.RecentInterventionsActivity"
            android:exported="false" />

        <activity
            android:name=".search.SearchActivity"
            android:exported="false" />

        <activity
            android:name=".pointage.PointageActivity"
            android:exported="false" />

        <receiver android:name=".pointage.PointageReminderReceiver" android:exported="false" />
        <receiver android:name=".pointage.PointageBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".navigation.NavigationTerrainActivity"
            android:exported="false"
            android:screenOrientation="fullSensor" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask" />

        <!-- Ecran de lancement : joue l'intro animee puis enchaine sur MainActivity
             (voir IntroActivity.kt). Remplace MainActivity comme LAUNCHER. -->
        <activity
            android:name=".IntroActivity"
            android:exported="true"
            android:theme="@style/Theme.HydriaApp.Intro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
