<?xml version="1.0" encoding="utf-8"?>
<!--
  Police téléchargeable via le fournisseur Google Fonts (aucun .ttf à embarquer).
  ResourcesCompat.getFont() peut renvoyer null au tout premier lancement le temps
  du téléchargement : HydriaType retombe alors sur sans-serif jusqu'à l'arrivée
  d'Archivo. Les graisses sont demandées par Typeface.create(..., weight, false).
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:fontProviderAuthority="com.google.android.gms.fonts"
    app:fontProviderPackage="com.google.android.gms"
    app:fontProviderQuery="name=Archivo&amp;weight=400"
    app:fontProviderCerts="@array/com_google_android_gms_fonts_certs" />
