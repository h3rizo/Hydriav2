<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hydria_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_representant_nom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/hydria_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/check_quantite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Quantité d'eau suffisante"
            android:textColor="@color/hydria_text" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/check_qualite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Qualité de l'eau satisfaisante"
            android:textColor="@color/hydria_text" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/check_delai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Délai de réparation correct"
            android:textColor="@color/hydria_text" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/check_relation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bonne relation avec le gestionnaire"
            android:textColor="@color/hydria_text" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Problème technique (si applicable)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_probleme_technique"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/hydria_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Problème de recouvrement (si applicable)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_probleme_recouvrement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/hydria_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Problème sur les règles d'utilisation (si applicable)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_probleme_regles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/hydria_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Remarques">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_remarque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/hydria_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Enregistrer l'avis" />

    </LinearLayout>
</ScrollView>
