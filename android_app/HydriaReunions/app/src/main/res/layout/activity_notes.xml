<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hydria_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/text_entity_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/hydria_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_disabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Les notes avancées ne sont pas encore activées côté serveur."
        android:textColor="@color/hydria_warning"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_notes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_add_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nouvelle note" />

</LinearLayout>
