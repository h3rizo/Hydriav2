# Copier en `keystore.properties` (non versionne) et renseigner les vraies valeurs.
# Necessaire uniquement pour signer le build release (./gradlew :app:assembleRelease).
#
# storeFile : chemin ABSOLU vers le keystore .jks (utiliser des / meme sous Windows)
# Genere une fois avec :
#   keytool -genkeypair -v -keystore C:/Users/<toi>/keystores/bienetre-release.jks \
#           -alias bienetre -keyalg RSA -keysize 2048 -validity 10000
#
# IMPORTANT : conserver ce keystore et ces mots de passe de facon permanente.
# Toute mise a jour future de l'app sur le meme appareil exige la MEME cle.

storeFile=C:/Users/Dir Soakoja/keystores/bienetre-release.jks
storePassword=CHANGE_ME
keyAlias=bienetre
keyPassword=CHANGE_ME
