# Configuration d'environnement Hydria Frontend
# Copiez ce fichier vers .env et remplissez vos valeurs

# Supabase Configuration
SUPABASE_URL=https://ytqvyihgztdnwkgvozqn.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API Backend URL
API_BASE_URL=http://localhost:8000/api

# Application Configuration
NODE_ENV=development
APP_VERSION=1.0.0

# PWA Configuration (optionnel)
PWA_NAME="Hydria - Gestion Eau Madagascar"
PWA_SHORT_NAME="Hydria"
PWA_DESCRIPTION="Application de gestion opérationnelle pour l'approvisionnement en eau à Madagascar"

# Analytics (optionnel)
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Monitoring (optionnel)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id