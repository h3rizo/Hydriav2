{
  "name": "hydria-frontend",
  "version": "1.0.0",
  "description": "Hydria PWA Frontend - Application de gestion hors ligne",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "css:build": "npx tailwindcss -i ./src/css/input.css -o ./dist/css/hydria.css --minify",
    "css:dev": "npx tailwindcss -i ./src/css/input.css -o ./dist/css/hydria.css --watch"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^8.5.6",
    "@nuxtjs/supabase": "^1.4.2",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@pinia/nuxt": "^0.5.5",
    "@supabase/supabase-js": "^2.47.10",
    "@vite-pwa/nuxt": "^0.10.5",
    "chart.js": "^4.5.0",
    "daisyui": "^5.1.9",
    "localforage": "^1.10.0",
    "nuxt": "^3.14.159",
    "pinia": "^2.2.6",
    "vue": "latest",
    "vue-router": "^4.4.5",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.4",
    "@nuxt/kit": "^4.1.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.9.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.15.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  }
}
