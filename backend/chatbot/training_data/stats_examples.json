{
  "description": "Exemples d'entraînement pour les demandes de statistiques et comptages",
  "version": "1.0",
  "examples": [
    {
      "category": "Comptages simples",
      "questions": [
        "Combien d'ouvrages ?",
        "Nombre d'ouvrages",
        "Combien y a-t-il d'ouvrages ?",
        "Donne moi le nombre d'ouvrages",
        "Affiche le total des ouvrages"
      ],
      "expected_entities": ["ouvrage"],
      "expected_response_type": "count"
    },
    {
      "category": "Points d'eau",
      "questions": [
        "Combien de points d'eau ?",
        "Nombre de branchements",
        "Combien y a-t-il de points d'eau privés ?",
        "Nombre de BP",
        "Total des bornes fontaines",
        "Combien de points d'eau publics ?",
        "Nombre de points d'eau coupés"
      ],
      "expected_entities": ["point_eau", "point_eau_prive", "point_eau_public", "point_eau_coupe"],
      "expected_response_type": "count"
    },
    {
      "category": "Équipements et infrastructure",
      "questions": [
        "Combien d'équipements ?",
        "Nombre d'équipements constitutifs",
        "Total des compteurs de tête",
        "Combien y a-t-il de compteurs ?",
        "Nombre d'adresses enregistrées"
      ],
      "expected_entities": ["equipement", "compteur_tete", "adresse"],
      "expected_response_type": "count"
    },
    {
      "category": "Gestion et tarification",
      "questions": [
        "Combien de tarifs actifs ?",
        "Nombre de modalités de gestion",
        "Total des fournisseurs",
        "Combien de cartes sociales ?",
        "Liste des modalités actives"
      ],
      "expected_entities": ["tarif", "modalite", "fournisseur", "carte_sociale"],
      "expected_response_type": "count"
    },
    {
      "category": "Filtres géographiques",
      "questions": [
        "Combien d'ouvrages dans la région Fitovinany ?",
        "Nombre de points d'eau dans le district de Manakara",
        "Total des habitants dans la commune de Vohipeno",
        "Combien d'équipements en région Fitovinany ?",
        "Points d'eau pour le district de Manakara"
      ],
      "expected_entities": ["ouvrage", "point_eau", "habitant", "equipement"],
      "expected_filters": ["region", "district", "commune"],
      "expected_response_type": "count_with_filters"
    },
    {
      "category": "Filtres temporels",
      "questions": [
        "Combien d'ouvrages en 2023 ?",
        "Nombre de points d'eau pour l'année 2024",
        "Total des ouvrages créés en 2022",
        "Points d'eau branchés en 2023",
        "Statistiques pour l'année 2024"
      ],
      "expected_entities": ["ouvrage", "point_eau"],
      "expected_filters": ["annee"],
      "expected_response_type": "count_with_filters"
    },
    {
      "category": "Filtres combinés",
      "questions": [
        "Combien d'ouvrages dans la région Fitovinany en 2023 ?",
        "Nombre de points d'eau dans le district de Manakara pour l'année 2024",
        "Total des habitants dans la commune de Vohipeno en 2023",
        "Équipements en région Fitovinany pour 2024"
      ],
      "expected_entities": ["ouvrage", "point_eau", "habitant", "equipement"],
      "expected_filters": ["region", "district", "commune", "annee"],
      "expected_response_type": "count_with_filters"
    },
    {
      "category": "Statistiques générales",
      "questions": [
        "Donne moi les statistiques",
        "Résumé des données",
        "Vue d'ensemble",
        "Statistiques globales",
        "Affiche un résumé"
      ],
      "expected_entities": [],
      "expected_response_type": "summary"
    },
    {
      "category": "Comparaisons",
      "questions": [
        "Combien de points d'eau privés vs publics ?",
        "Différence entre BP et bornes fontaines",
        "Répartition des points d'eau",
        "Nombre de points d'eau par type"
      ],
      "expected_entities": ["point_eau_prive", "point_eau_public"],
      "expected_response_type": "comparison"
    },
    {
      "category": "Questions multiples",
      "questions": [
        "Combien d'ouvrages et de points d'eau ?",
        "Nombre d'équipements et de compteurs",
        "Total des tarifs et modalités",
        "Statistiques sur les ouvrages, points d'eau et habitants"
      ],
      "expected_entities": ["ouvrage", "point_eau", "equipement", "compteur_tete", "tarif", "modalite", "habitant"],
      "expected_response_type": "multiple_counts"
    }
  ],
  "patterns": {
    "count_questions": [
      "combien (de)?",
      "nombre (de)?",
      "total (de)?",
      "il y a combien",
      "donne moi le nombre",
      "affiche le total",
      "montre moi combien"
    ],
    "geographic_filters": {
      "region": "(?:dans|en|pour|à) (?:la )?région (.+)",
      "district": "(?:dans|en|pour|à) (?:le )?district (?:de )?(.+)",
      "commune": "(?:dans|en|pour|à) (?:la )?commune (?:de )?(.+)"
    },
    "temporal_filters": {
      "annee": "(?:en|pour|de) (?:l')?année (\\d{4})"
    }
  },
  "entities": {
    "ouvrage": ["ouvrage", "ouvrages", "infrastructure", "infrastructures"],
    "point_eau": ["point d'eau", "points d'eau", "point eau", "points eau", "branchement", "branchements"],
    "point_eau_prive": ["point d'eau privé", "points d'eau privés", "bp", "branchement privé"],
    "point_eau_public": ["point d'eau public", "points d'eau publics", "borne fontaine", "bornes fontaines"],
    "point_eau_coupe": ["point d'eau coupé", "points d'eau coupés", "branchement coupé", "coupure"],
    "equipement": ["équipement", "équipements", "equipement", "equipements"],
    "compteur_tete": ["compteur de tête", "compteurs de tête", "compteur tête", "compteurs tête", "compteur", "compteurs"],
    "adresse": ["adresse", "adresses"],
    "carte_sociale": ["carte sociale", "cartes sociales"],
    "tarif": ["tarif", "tarifs", "tarif volumétrique", "tarifs volumétriques"],
    "modalite": ["modalité", "modalités", "modalité de gestion", "modalités de gestion"],
    "fournisseur": ["fournisseur", "fournisseurs"],
    "commune": ["commune", "communes"],
    "habitant": ["habitant", "habitants", "population"]
  },
  "response_templates": {
    "single_count": "Il y a **{count}** {entity_name}.",
    "multiple_counts": "Voici les statistiques demandées:\n{counts_list}",
    "with_filters": "**Filtres appliqués:** {filters}\n\n{counts}",
    "summary": "Voici un résumé des statistiques:\n• **{ouvrages}** ouvrages\n• **{points_eau}** points d'eau\n  - {points_eau_prives} privés (BP)\n  - {points_eau_publics} publics\n• **{habitants}** habitants",
    "error": "Désolé, je n'ai pas pu récupérer les statistiques. {details}"
  },
  "usage_notes": [
    "Le chatbot reconnaît automatiquement les entités mentionnées dans la question",
    "Les filtres géographiques (région, district, commune) sont extraits du contexte",
    "Les filtres temporels (année) sont extraits et appliqués en mode cumulatif",
    "Si aucune entité n'est spécifiée, un résumé général est fourni",
    "Le chatbot peut gérer plusieurs entités dans une même question",
    "Les réponses sont formatées avec mise en forme markdown (gras, listes)",
    "Les nombres sont formatés avec espaces pour faciliter la lecture"
  ]
}
