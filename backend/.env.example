# Configuration d'environnement Hydria Backend
# Copiez ce fichier vers .env et remplissez vos valeurs

# Django Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here-min-50-chars-for-security
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DJANGO_SETTINGS_MODULE=hydria.settings

# Database Configuration (Supabase)
DATABASE_URL=postgresql://postgres:CJbULo973C7Ie3ac@db.ytqvyihgztdnwkgvozqn.supabase.co:5432/postgres

# Supabase Configuration
SUPABASE_URL=https://ytqvyihgztdnwkgvozqn.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://hydria-frontend.onrender.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True

# Security Settings (Production uniquement)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# Email Configuration (optionnel)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# Logging
LOG_LEVEL=INFO

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440  # 2.5MB

# Cache (optionnel - Redis)
REDIS_URL=redis://localhost:6379/0

# Monitoring (optionnel)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Pre-remplissage IA des justificatifs comptables (apps.accounting.ai_prefill)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low
AI_PREFILL_MONTHLY_BUDGET_USD=25