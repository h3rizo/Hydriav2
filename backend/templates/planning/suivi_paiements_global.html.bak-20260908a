<script>
function resetFilters() {
    document.getElementById('volumeGlobalEmployeSelect').value = '';
    document.getElementById('regionsSelect').selectedIndex = -1;
    document.getElementById('districtsSelect').selectedIndex = -1;
    document.getElementById('communesSelect').selectedIndex = -1;
    document.getElementById('ouvragesSelect').selectedIndex = -1;
    const form = document.getElementById('filterForm');
    const scoreFilter = form.querySelector('input[name="score_ecart"]');
    if (scoreFilter) scoreFilter.remove();
    form.submit();
}

function toggleScoreGapFilter() {
    const url = new URL(window.location.href);
    if (url.searchParams.get('score_ecart') === '1') {
        url.searchParams.delete('score_ecart');
    } else {
        url.searchParams.set('score_ecart', '1');
    }
    window.location.href = url.toString();
}

(function initVolumeGlobalEmployeeCascade() {
    const employe = document.getElementById('volumeGlobalEmployeSelect');
    const regions = document.getElementById('regionsSelect');
    const districts = document.getElementById('districtsSelect');
    const communes = document.getElementById('communesSelect');
    const ouvrages = document.getElementById('ouvragesSelect');
    if (!employe || !regions || !districts || !communes || !ouvrages) return;

    const selectedValues = (select) => new Set(
        Array.from(select.selectedOptions || []).map((option) => option.value)
    );
    const matchesEmployee = (option) => !employe.value
        || (option.dataset.employeIds || '').split(',').filter(Boolean).includes(employe.value);

    function filterOptions(select, predicate) {
        Array.from(select.options || []).forEach((option) => {
            const visible = predicate(option);
            option.hidden = !visible;
            option.disabled = !visible;
            if (!visible) option.selected = false;
        });
    }

    function applyCascade() {
        filterOptions(regions, matchesEmployee);
        const regionIds = selectedValues(regions);
        filterOptions(districts, (option) =>
            (regionIds.size === 0 || regionIds.has(option.dataset.regionId)) && matchesEmployee(option));
        const districtIds = selectedValues(districts);
        filterOptions(communes, (option) => {
            const geographyMatches = districtIds.size > 0
                ? districtIds.has(option.dataset.districtId)
                : (regionIds.size === 0 || regionIds.has(option.dataset.regionId));
            return geographyMatches && matchesEmployee(option);
        });
        const communeIds = selectedValues(communes);
        filterOptions(ouvrages, (option) => {
            let geographyMatches = true;
            if (communeIds.size > 0) geographyMatches = communeIds.has(option.dataset.communeId);
            else if (districtIds.size > 0) geographyMatches = districtIds.has(option.dataset.districtId);
            else if (regionIds.size > 0) geographyMatches = regionIds.has(option.dataset.regionId);
            return geographyMatches && matchesEmployee(option);
        });
    }

    employe.addEventListener('change', () => {
        [regions, districts, communes, ouvrages].forEach((select) => { select.selectedIndex = -1; });
        applyCascade();
    });
    regions.addEventListener('change', () => {
        [districts, communes, ouvrages].forEach((select) => { select.selectedIndex = -1; });
        applyCascade();
    });
    districts.addEventListener('change', () => {
        [communes, ouvrages].forEach((select) => { select.selectedIndex = -1; });
        applyCascade();
    });
    communes.addEventListener('change', () => {
        ouvrages.selectedIndex = -1;
        applyCascade();
    });
    applyCascade();
})();

const isDirecteurPoste = {% if is_directeur_poste %}true{% else %}false{% endif %};
let currentReleveModalContext = null;
let selectedReleveIds = new Set();
let selectedDiamexEntry = null;

function getCsrfToken() {
    const cookieValue = document.cookie
        .split('; ')
        .find(row => row.startsWith('csrftoken='));
    return cookieValue ? cookieValue.split('=')[1] : '';
}

function fmtNumber(value, allowZero = false) {
    if (value === null || value === undefined) return '-';
    if (!allowZero && Number(value) === 0) return '-';
    return new Intl.NumberFormat('fr-FR').format(value);
}

function resetPointageSelection() {
    selectedReleveIds = new Set();
    selectedDiamexEntry = null;
    document.querySelectorAll('.releve-pointage-checkbox').forEach(cb => { cb.checked = false; });
    document.querySelectorAll('.diamex-pointage-radio').forEach(rb => { rb.checked = false; });
    updatePointageSummary();
}

function toggleRelevePointageSelection(releveId, checked) {
    const releves = (currentReleveModalContext && currentReleveModalContext.releves) || [];
    const releve = releves.find(r => String(r.id) === String(releveId));
    if (releve && releve.already_pointed) {
        return;
    }

    if (checked) {
        selectedReleveIds.add(String(releveId));
    } else {
        selectedReleveIds.delete(String(releveId));
    }
    updatePointageSummary();
}

function selectDiamexPointage(entryId) {
    if (!currentReleveModalContext || !currentReleveModalContext.diamexMap) {
        selectedDiamexEntry = null;
        updatePointageSummary();
        return;
    }
    selectedDiamexEntry = currentReleveModalContext.diamexMap[String(entryId)] || null;
    updatePointageSummary();
}

function updatePointageSummary() {
    const releves = (currentReleveModalContext && currentReleveModalContext.releves) || [];
    const selectedReleves = releves.filter(
        rel => !rel.already_pointed && selectedReleveIds.has(String(rel.id))
    );
    const totalReleves = selectedReleves.reduce((sum, rel) => sum + Number(rel.montant || 0), 0);
    const montantDiamex = Number(selectedDiamexEntry ? selectedDiamexEntry.montant_in : 0);
    const ecart = totalReleves - montantDiamex;

    document.getElementById('modal-pointage-count').textContent = String(selectedReleves.length);
    document.getElementById('modal-pointage-total').textContent = fmtNumber(totalReleves, true) + ' Ar';
    document.getElementById('modal-pointage-diamex').textContent = fmtNumber(montantDiamex, true) + ' Ar';
    document.getElementById('modal-pointage-ecart').textContent = fmtNumber(ecart, true) + ' Ar';

    const applyBtn = document.getElementById('modal-pointage-apply-btn');
    const canApply = selectedReleves.length > 0 && !!selectedDiamexEntry && Math.abs(ecart) <= 0.01;
    applyBtn.disabled = !canApply;
    applyBtn.classList.toggle('btn-success', canApply);
    applyBtn.classList.toggle('btn-info', !canApply);
}

async function applyPointageFromModal() {
    if (!selectedDiamexEntry || selectedReleveIds.size === 0) {
        alert('Selectionnez des releves et une ligne DiameX.');
        return;
    }

    const payload = {
        releve_ids: Array.from(selectedReleveIds),
        diamex_entry_id: selectedDiamexEntry.entry_id || selectedDiamexEntry.id,
        montant_diamex_selection: Number(selectedDiamexEntry.montant_in || 0)
    };

    try {
        const response = await fetch('{% url "accounting:api_pointage_releves_diamex" %}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': getCsrfToken()
            },
            body: JSON.stringify(payload)
        });
        const data = await response.json();
        if (!response.ok || !data.success) {
            throw new Error(data.error || 'Pointage impossible');
        }

        alert(data.message || 'Pointage effectue');
        await openReleveDetailsModal(
            currentReleveModalContext.ouvrageId,
            currentReleveModalContext.ouvrageNom,
            currentReleveModalContext.annee,
            currentReleveModalContext.mois
        );
    } catch (error) {
        alert(error.message || 'Erreur de pointage');
    }
}

async function deleteReleveFromModal(releveId) {
    if (!isDirecteurPoste) {
        alert('Acces refuse.');
        return;
    }
    if (!confirm('Supprimer cette ligne de releve ?')) {
        return;
    }

    try {
        const response = await fetch('{% url "accounting:api_delete_releve_pointage" %}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': getCsrfToken()
            },
            body: JSON.stringify({ releve_id: releveId })
        });
        const data = await response.json();
        if (!response.ok || !data.success) {
            throw new Error(data.error || 'Suppression impossible');
        }

        await openReleveDetailsModal(
            currentReleveModalContext.ouvrageId,
            currentReleveModalContext.ouvrageNom,
            currentReleveModalContext.annee,
            currentReleveModalContext.mois
        );
    } catch (error) {
        alert(error.message || 'Erreur de suppression');
    }
}

async function cutWaterFromModal(pointEauId) {
    if (!pointEauId) {
        alert('Point d\'eau introuvable pour ce releve.');
        return;
    }

    if (!confirm('Confirmer la coupure d\'eau pour cet abonne ?')) {
        return;
    }

    const dateCoupure = new Date().toISOString().split('T')[0];

    try {
        const response = await fetch('{% url "billing:api_couper_point_eau" %}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': getCsrfToken()
            },
            body: JSON.stringify({
                point_eau_id: pointEauId,
                date_coupure: dateCoupure,
                motif: 'Coupure depuis modal details recouvrement'
            })
        });

        const data = await response.json();
        if (!response.ok || !data.success) {
            throw new Error(data.error || 'Coupure impossible');
        }

        alert(data.message || 'Point d\'eau coupe avec succes.');
        await openReleveDetailsModal(
            currentReleveModalContext.ouvrageId,
            currentReleveModalContext.ouvrageNom,
            currentReleveModalContext.annee,
            currentReleveModalContext.mois
        );
    } catch (error) {
        alert(error.message || 'Erreur lors de la coupure');
    }
}

async function openReleveDetailsModal(ouvrageId, ouvrageNom, annee, mois) {
    const monthNames = ['Janvier', 'Fevrier', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Aout', 'Septembre', 'Octobre', 'Novembre', 'Decembre'];
    const moisLabel = monthNames[parseInt(mois, 10) - 1] || String(mois);

    currentReleveModalContext = {
        ouvrageId: String(ouvrageId),
        ouvrageNom,
        annee: parseInt(annee, 10),
        mois: parseInt(mois, 10),
        releves: [],
        diamexMap: {}
    };
    selectedReleveIds = new Set();
    selectedDiamexEntry = null;

    document.getElementById('modal-releve-details').checked = true;
    document.getElementById('modal-releve-title').innerHTML = `
        <div class="flex items-center justify-between w-full pr-8">
            <span>Details : ${ouvrageNom}</span>
            <span class="badge badge-lg badge-outline border-base-content/30">${moisLabel} ${annee}</span>
        </div>
    `;

    const loading = document.getElementById('modal-releve-loading');
    const content = document.getElementById('modal-releve-content');
    const error = document.getElementById('modal-releve-error');

    loading.classList.remove('hidden');
    content.classList.add('hidden');
    error.classList.add('hidden');

    try {
        const apiMois = parseInt(mois, 10);
        const apiAnnee = parseInt(annee, 10);

        const response = await fetch(`{% url "accounting:api_details_recoupement_3e" %}?ouvrage_id=${ouvrageId}&annee=${apiAnnee}&mois=${apiMois}`);
        const data = await response.json();

        if (!data.success) throw new Error(data.error || 'Erreur lors de la recuperation des donnees');

        const stats = data.stats || {};
        document.getElementById('modal-releve-total-prevu').textContent = fmtNumber(stats.total_releves || 0, true) + ' Ar';
        document.getElementById('modal-releve-total-paye').textContent = fmtNumber(stats.total_diamex || 0, true) + ' Ar';
        document.getElementById('modal-releve-count').textContent = (stats.nb_releves || 0) + ' releve(s)';
        document.getElementById('modal-releve-diamex-count').textContent = (stats.nb_transactions_diamex || 0) + ' transaction(s) DiameX';

        const tauxStats = stats.taux_recouvrement !== undefined
            ? stats.taux_recouvrement
            : ((stats.total_releves > 0) ? Math.round((stats.total_diamex || 0) / stats.total_releves * 100) : 0);

        document.getElementById('modal-releve-taux').textContent = tauxStats + '%';
        document.getElementById('modal-releve-ecart').textContent = 'ecart: ' + fmtNumber(stats.ecart || 0, true) + ' Ar';

        const statusCard = document.getElementById('modal-releve-statut-card');
        statusCard.className = 'p-3 rounded-lg text-center shadow-inner border ' +
            (tauxStats >= 95 ? 'bg-success/10 border-success/20 text-success' :
            (tauxStats >= 80 ? 'bg-warning/10 border-warning/20 text-warning' : 'bg-error/10 border-error/20 text-error'));

        const normalizeValue = (v) => String(v || '').trim().toLowerCase();
        const makePairKey = (num, base) => `${normalizeValue(num)}||${normalizeValue(base)}`;

        const relPairs = new Set();
        (data.releves || []).forEach(rel => {
            const num = rel.numeroDiameX || '';
            const base = rel.baseDiameX || '';
            if (normalizeValue(num) && normalizeValue(base)) {
                relPairs.add(makePairKey(num, base));
            }
        });

        const diamexPairs = new Set();
        (data.transactions_diamex || []).forEach(tx => {
            const num = tx.id_access || '';
            const base = tx.prog || '';
            if (normalizeValue(num) && normalizeValue(base)) {
                diamexPairs.add(makePairKey(num, base));
            }
        });

        const commonPairs = [];
        relPairs.forEach(key => {
            if (diamexPairs.has(key)) commonPairs.push(key);
        });
        const commonPairSet = new Set(commonPairs);

        const releveBody = document.getElementById('modal-releve-table-body');
        releveBody.innerHTML = '';
        document.getElementById('modal-releve-delete-col-head').classList.toggle('hidden', !isDirecteurPoste);

        (data.releves || []).forEach(rel => {
            const numeroDiamex = rel.numeroDiameX || '';
            const baseDiamex = rel.baseDiameX || '';
            const isMatchedPair = commonPairSet.has(makePairKey(numeroDiamex, baseDiamex));
            const isAlreadyPointed = !!rel.already_pointed;
            const isNonRecouvrable = !!rel.non_recouvrable;

            const tr = document.createElement('tr');
            if (isMatchedPair) tr.classList.add('bg-success/10');
            if (isNonRecouvrable) tr.classList.add('bg-base-200/70');
            if (isAlreadyPointed) tr.classList.add('opacity-70');

            tr.innerHTML = `
                <td class="text-center">
                    <input type="checkbox" class="checkbox checkbox-xs releve-pointage-checkbox"
                        ${isAlreadyPointed ? 'disabled' : ''}
                        onchange="toggleRelevePointageSelection('${rel.id}', this.checked)">
                </td>
                <td class="font-mono text-[10px]">${rel.idxls || '-'}</td>
                <td><div class="font-bold">${rel.nom_abonne || '-'}</div></td>
                <td>${rel.type_point_eau || '-'}</td>
                <td class="text-right font-mono">${fmtNumber(rel.index_ancien, true)}</td>
                <td class="text-right font-mono">${fmtNumber(rel.nouvelindex, true)}</td>
                <td class="text-right font-mono font-bold">${fmtNumber(rel.consommation, true)}</td>
                <td class="text-right font-mono font-bold text-success">${fmtNumber(rel.montant, true)}</td>
                <td class="text-center font-mono text-[10px]">${numeroDiamex || '-'}</td>
                <td class="text-center text-[10px]">${baseDiamex || '-'}</td>
                <td class="text-center">
                    ${isAlreadyPointed
                        ? `<span class="badge badge-success badge-xs gap-1"><i class="fas fa-lock"></i> Deja pointe</span>${isMatchedPair ? '<span class="badge badge-outline badge-xs ml-1">Existe en compta</span>' : ''}`
                        : (isNonRecouvrable
                            ? '<span class="badge badge-neutral badge-xs" title="Exclue du prévu, sélection toujours autorisée">Hors recouvrement — pointable</span>'
                            : '<span class="badge badge-ghost badge-xs opacity-50">Non pointe</span>')}
                </td>
                <td class="text-center">
                    ${rel.est_coupe
                        ? '<span class="badge badge-warning badge-xs">Deja coupe</span>'
                        : (rel.point_eau_id
                            ? `<button class="btn btn-xs btn-warning btn-outline" onclick="cutWaterFromModal('${rel.point_eau_id}')"><i class="fas fa-tint-slash"></i></button>`
                            : '<span class="opacity-40">-</span>')}
                </td>
                <td class="text-center ${isDirecteurPoste ? '' : 'hidden'}">
                    ${isDirecteurPoste
                        ? `<button class="btn btn-xs btn-error btn-outline" onclick="deleteReleveFromModal('${rel.id}')"><i class="fas fa-trash"></i></button>`
                        : ''}
                </td>
            `;
            releveBody.appendChild(tr);
        });

        const diamexBody = document.getElementById('modal-diamex-table-body');
        diamexBody.innerHTML = '';

        (data.transactions_diamex || []).forEach(trData => {
            const isAlreadyPointed = !!trData.already_pointed;
            const rowId = String(trData.entry_id || trData.id);
            const isMatchedPair = commonPairSet.has(makePairKey(trData.id_access || '', trData.prog || ''));
            currentReleveModalContext.diamexMap[rowId] = trData;

            const tr = document.createElement('tr');
            if (isMatchedPair) tr.classList.add('bg-success/10');

            tr.innerHTML = `
                <td class="text-center">
                    <input type="radio" name="diamex_pointage_select" class="radio radio-xs diamex-pointage-radio"
                        value="${rowId}" ${isAlreadyPointed ? 'disabled' : ''}
                        onchange="selectDiamexPointage('${rowId}')">
                </td>
                <td class="font-mono text-[10px]">${trData.date_rec || '-'}</td>
                <td class="text-[10px] max-w-xs break-words">${trData.description || '-'}</td>
                <td class="text-right font-mono font-bold text-primary">${fmtNumber(trData.montant_in, true)}</td>
                <td class="text-center font-mono text-[10px]">${trData.id_access || '-'}</td>
                <td><div class="text-[10px] opacity-70">${trData.prog || '-'}</div></td>
                <td class="text-center">
                    ${isAlreadyPointed
                        ? '<span class="badge badge-success badge-xs">Deja pointe</span>'
                        : '<span class="badge badge-ghost badge-xs">A pointer</span>'}
                    ${isMatchedPair ? '<span class="badge badge-outline badge-xs ml-1">Existe en releves</span>' : ''}
                </td>
                <td><div class="text-[10px] truncate max-w-[100px]" title="${trData.scan || ''}">${trData.scan || '-'}</div></td>
                <td class="text-center">
                    ${trData.scan
                        ? `<button onclick="viewScan('${rowId}', '${(trData.scan_path || trData.scan || '').replace(/'/g, "\\\\'")}')" class="btn btn-xs btn-ghost btn-circle" title="Voir le scan"><i class="fas fa-file-pdf text-error"></i></button>`
                        : '-'}
                </td>
            `;
            diamexBody.appendChild(tr);
        });

        currentReleveModalContext.releves = data.releves || [];
        updatePointageSummary();

        const matchingList = document.getElementById('modal-matching-couples-list');
        const matchingTotalsWrap = document.getElementById('modal-matching-couples-totals-wrap');
        const matchingTotalsBody = document.getElementById('modal-matching-couples-totals-body');

        if (commonPairs.length > 0) {
            matchingList.innerHTML = commonPairs.map(pair => {
                const [num, base] = pair.split('||');
                return `<span class="badge badge-success badge-sm">${num.toUpperCase()} / ${base.toUpperCase()}</span>`;
            }).join('');
        } else {
            matchingList.innerHTML = '<span class="italic opacity-60">Aucune correspondance</span>';
        }

        const couplesStats = Array.isArray(data.matching_couples_stats) ? data.matching_couples_stats : [];
        if (couplesStats.length > 0) {
            matchingTotalsWrap.classList.remove('hidden');
            matchingTotalsBody.innerHTML = couplesStats.map(item => {
                const ecart = Number(item.ecart_global || 0);
                const ecartClass = ecart > 0 ? 'text-warning' : (ecart < 0 ? 'text-error' : 'text-success');
                return `
                    <tr>
                        <td class="font-mono">${item.numero_diamex || '-'} / ${item.base_diamex || '-'}</td>
                        <td class="text-right font-mono">${fmtNumber(item.total_releves_global, true)} Ar</td>
                        <td class="text-right font-mono">${fmtNumber(item.total_diamex_global, true)} Ar</td>
                        <td class="text-right font-mono font-bold ${ecartClass}">${fmtNumber(ecart, true)} Ar</td>
                    </tr>
                `;
            }).join('');
        } else {
            matchingTotalsWrap.classList.add('hidden');
            matchingTotalsBody.innerHTML = '<tr><td colspan="4" class="text-center py-2 opacity-60 italic">Aucune donnee</td></tr>';
        }

        if ((data.releves || []).length === 0) {
            releveBody.innerHTML = '<tr><td colspan="13" class="text-center py-4 opacity-50 italic">Aucun releve pour cette periode</td></tr>';
        }
        if ((data.transactions_diamex || []).length === 0) {
            diamexBody.innerHTML = '<tr><td colspan="9" class="text-center py-4 opacity-50 italic">Aucune transaction DiameX trouvee</td></tr>';
        }

        loading.classList.add('hidden');
        content.classList.remove('hidden');
    } catch (err) {
        loading.classList.add('hidden');
        error.classList.remove('hidden');
        document.getElementById('modal-releve-error-text').textContent = err.message;
    }
}

function isLikelyLocalPath(filePath) {
    if (!filePath) return false;
    return /^[a-zA-Z]:[\\/]/.test(filePath) || filePath.startsWith('\\\\') || filePath.startsWith('/');
}

function openFileViaLocalAgent(filePath) {
    return fetch('http://127.0.0.1:8765/open-file', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ file_path: filePath })
    }).then(r => r.json());
}

function viewScan(entryId, filePath) {
    if (filePath && isLikelyLocalPath(filePath)) {
        openFileViaLocalAgent(filePath)
            .then(data => {
                if (!data.ok || !data.success) {
                    alert('Impossible d\'ouvrir le scan localement. Detail: ' + (data.error || 'Erreur inconnue'));
                }
            })
            .catch(error => {
                alert('Agent local injoignable. Detail: ' + error.message);
            });
        return;
    }

    if (entryId) {
        window.open('/comptabilite/scan/' + entryId + '/', '_blank');
        return;
    }

    alert('Aucun scan disponible.');
}

function initGlobalMonthlyCellClicks() {
    const table = document.getElementById('tableau-global-paiements');
    if (!table) return;
    const visibleMonths = [
        {% for month in visible_mois_colonnes_globales %}
        {{ month.number }}{% if not forloop.last %}, {% endif %}
        {% endfor %}
    ];

    const rows = Array.from(table.querySelectorAll('tbody tr'));
    rows.forEach((row) => {
        const actionLink = row.querySelector('a[href*="ouvrage="]');
        if (!actionLink) return;

        let ouvrageId = '';
        try {
            const parsed = new URL(actionLink.href, window.location.origin);
            ouvrageId = parsed.searchParams.get('ouvrage') || '';
        } catch (e) {
            ouvrageId = '';
        }
        if (!ouvrageId) return;

        const firstCell = row.querySelector('td');
        const ouvrageNom = firstCell ? (firstCell.textContent || '').trim() : '';
        const cells = row.querySelectorAll('td');

        visibleMonths.forEach((monthNumber, index) => {
            const cell = cells[4 + index];
            if (!cell) continue;

            const normalized = (cell.textContent || '').replace(/\s+/g, '').trim();
            if (!normalized || normalized === '-') continue;

            cell.classList.add('cursor-pointer', 'clickable-month-cell');
            cell.title = 'Voir les details et pointer';
            cell.addEventListener('click', () => {
                openReleveDetailsModal(ouvrageId, ouvrageNom, '{{ annee_filter }}', monthNumber);
            });
        });
    });
}

function toggleMonthlyInfos(show) {
    document.querySelectorAll('.monthly-info-details').forEach((el) => {
        el.classList.toggle('hidden', !show);
    });
}

document.addEventListener('DOMContentLoaded', () => {
    initGlobalMonthlyCellClicks();
    const toggle = document.getElementById('toggle-monthly-infos');
    if (toggle) {
        toggleMonthlyInfos(!!toggle.checked);
    }
});
</script>
