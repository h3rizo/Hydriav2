{% extends planning_shell_base_template %}
{% load humanize %}
{% load l10n %}
{% load planning_extras %}

{% block extra_css %}
<style>
    .clickable-month-cell {
        transition: background-color 0.15s ease, transform 0.12s ease;
    }

    .clickable-month-cell:hover {
        background-color: hsl(var(--b3, 220 18% 20%) / 0.35);
    }

    .clickable-month-cell:active {
        transform: scale(0.985);
    }
</style>
{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- En-tête -->
    <div class="flex justify-between items-center">
        <h1 class="text-3xl font-bold">{{ title }}</h1>
        <div class="flex gap-2">
            <a href="{% url 'planning:gestion_volumetrique' %}" class="btn btn-ghost btn-sm">
                <i class="fas fa-table mr-2"></i>Vue détaillée par point d'eau
            </a>
        </div>
    </div>

    <!-- Stats globales -->
    <div class="stats shadow w-full grid" style="grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));">
        {% if employee_points_score.visible %}
        <button type="button"
            class="stat min-w-0 overflow-hidden bg-secondary/10 text-left transition-all {% if employee_points_score.points_ecart %}cursor-pointer hover:bg-secondary/15{% else %}cursor-default{% endif %} {% if show_only_score_gap %}ring-2 ring-inset ring-secondary{% endif %}"
            {% if employee_points_score.points_ecart %}onclick="toggleScoreGapFilter()"{% else %}disabled{% endif %}
            aria-pressed="{% if show_only_score_gap %}true{% else %}false{% endif %}"
            title="{% if employee_points_score.points_ecart %}Filtrer les tableaux sur les {{ employee_points_score.points_ecart }} points d'eau responsables de l'écart{% else %}Tous les points d'eau ont obtenu leur point{% endif %}">
            <div class="stat-figure text-secondary">
                <div class="radial-progress text-secondary" style="--value:{{ employee_points_score.pourcentage|unlocalize }}; --size:3.5rem; --thickness:4px;" role="progressbar">
                    {{ employee_points_score.pourcentage|floatformat:0 }}%
                </div>
            </div>
            <div class="stat-title text-secondary">{{ employee_points_score.scope_label }}</div>
            <div class="stat-value text-secondary text-2xl whitespace-nowrap">{{ employee_points_score.points_acquis }} / {{ employee_points_score.points_max }}</div>
            <div class="stat-desc whitespace-normal">
                <span class="block font-semibold">{{ employee_points_score.scope_name }}</span>
                <span class="block">1 point par point d'eau payé à 100% · mois clôturés uniquement</span>
                {% if employee_points_score.points_ecart %}
                <span class="mt-1 block font-semibold">
                    <i class="fas fa-filter mr-1" aria-hidden="true"></i>
                    {{ employee_points_score.points_ecart }} point{{ employee_points_score.points_ecart|pluralize }} responsable{{ employee_points_score.points_ecart|pluralize }} de l'écart
                    {% if show_only_score_gap %}<span class="badge badge-secondary badge-xs ml-1">Filtre actif</span>{% endif %}
                </span>
                {% endif %}
            </div>
        </button>
        {% endif %}
        <div class="stat">
            <div class="stat-figure text-info"><i class="fas fa-tint text-3xl"></i></div>
            <div class="stat-title">Points d'eau</div>
            <div class="stat-value text-info">{{ stats.total_points_eau|intcomma }}</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-primary"><i class="fas fa-file-invoice text-3xl"></i></div>
            <div class="stat-title">Total Factures</div>
            <div class="stat-value text-primary">{{ stats.total_factures|intcomma }}</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-success"><i class="fas fa-check-circle text-3xl"></i></div>
            <div class="stat-title">Payées</div>
            <div class="stat-value text-success">{{ stats.factures_payees|intcomma }}</div>
            <div class="stat-desc">{{ stats.taux_paiement }}% du total</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-error"><i class="fas fa-times-circle text-3xl"></i></div>
            <div class="stat-title">Impayées</div>
            <div class="stat-value text-error">{{ stats.factures_impayees|intcomma }}</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-warning"><i class="fas fa-chart-pie text-3xl"></i></div>
            <div class="stat-title">Taux global</div>
            <div class="stat-value text-warning">{{ stats.taux_paiement }}%</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-error"><i class="fas fa-cut text-3xl"></i></div>
            <div class="stat-title">Points d'eau coupés</div>
            <div class="stat-value text-error">{{ stats.points_eau_coupes|intcomma }}</div>
            <div class="stat-desc">Branchements arrêtés</div>
        </div>
    </div>

    <!-- Répartition par statut de paiement (Ouvrage-Type) -->
    <div class="card bg-base-100 shadow">
        <div class="card-body">
            <h2 class="card-title mb-4">
                <i class="fas fa-chart-bar mr-2 text-primary"></i>
                Répartition des Ouvrages-Types par Statut de Paiement
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Tout Payé -->
                <div class="stat bg-base-200 rounded-lg">
                    <div class="stat-figure">
                        <div class="radial-progress text-success" style="--value:{% widthratio stats.nb_tout_paye stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye 100 %}; --size:4rem; --thickness:4px;" role="progressbar">
                            {% if stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye > 0 %}
                                {% widthratio stats.nb_tout_paye stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye 100 %}%
                            {% else %}
                                0%
                            {% endif %}
                        </div>
                    </div>
                    <div class="stat-title">Tout Payé</div>
                    <div class="stat-value text-success text-2xl">{{ stats.nb_tout_paye|intcomma }}</div>
                    <div class="stat-desc">
                        {% if stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye > 0 %}
                            {% widthratio stats.nb_tout_paye stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye 100 %}% du total
                        {% else %}
                            0% du total
                        {% endif %}
                    </div>
                </div>

                <!-- Partiellement Payé -->
                <div class="stat bg-base-200 rounded-lg">
                    <div class="stat-figure">
                        <div class="radial-progress text-warning" style="--value:{% widthratio stats.nb_partiellement_paye stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye 100 %}; --size:4rem; --thickness:4px;" role="progressbar">
                            {% if stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye > 0 %}
                                {% widthratio stats.nb_partiellement_paye stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye 100 %}%
                            {% else %}
                                0%
                            {% endif %}
                        </div>
                    </div>
                    <div class="stat-title">Partiellement Payé</div>
                    <div class="stat-value text-warning text-2xl">{{ stats.nb_partiellement_paye|intcomma }}</div>
                    <div class="stat-desc">
                        {% if stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye > 0 %}
                            {% widthratio stats.nb_partiellement_paye stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye 100 %}% du total
                        {% else %}
                            0% du total
                        {% endif %}
                    </div>
                </div>

                <!-- Non Payé -->
                <div class="stat bg-base-200 rounded-lg">
                    <div class="stat-figure">
                        <div class="radial-progress text-error" style="--value:{% widthratio stats.nb_non_paye stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye 100 %}; --size:4rem; --thickness:4px;" role="progressbar">
                            {% if stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye > 0 %}
                                {% widthratio stats.nb_non_paye stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye 100 %}%
                            {% else %}
                                0%
                            {% endif %}
                        </div>
                    </div>
                    <div class="stat-title">Non Payé</div>
                    <div class="stat-value text-error text-2xl">{{ stats.nb_non_paye|intcomma }}</div>
                    <div class="stat-desc">
                        {% if stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye > 0 %}
                            {% widthratio stats.nb_non_paye stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye 100 %}% du total
                        {% else %}
                            0% du total
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Barre de progression globale -->
            <div class="mt-4">
                <div class="flex justify-between mb-2 text-sm">
                    <span><i class="fas fa-check-circle text-success mr-1"></i> Tout payé: {{ stats.nb_tout_paye }}</span>
                    <span><i class="fas fa-exclamation-circle text-warning mr-1"></i> Partiellement: {{ stats.nb_partiellement_paye }}</span>
                    <span><i class="fas fa-times-circle text-error mr-1"></i> Non payé: {{ stats.nb_non_paye }}</span>
                </div>
                {% with total=stats.nb_tout_paye|add:stats.nb_partiellement_paye|add:stats.nb_non_paye %}
                    {% if total > 0 %}
                        <div class="flex w-full h-6 rounded-lg overflow-hidden">
                            <div class="bg-success flex items-center justify-center text-white text-xs font-bold" style="width: {% widthratio stats.nb_tout_paye total 100 %}%">
                                {% widthratio stats.nb_tout_paye total 100 %}%
                            </div>
                            <div class="bg-warning flex items-center justify-center text-white text-xs font-bold" style="width: {% widthratio stats.nb_partiellement_paye total 100 %}%">
                                {% widthratio stats.nb_partiellement_paye total 100 %}%
                            </div>
                            <div class="bg-error flex items-center justify-center text-white text-xs font-bold" style="width: {% widthratio stats.nb_non_paye total 100 %}%">
                                {% widthratio stats.nb_non_paye total 100 %}%
                            </div>
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            <span>Aucune donnée disponible pour cette période</span>
                        </div>
                    {% endif %}
                {% endwith %}
            </div>
        </div>
    </div>

    <!-- Filtres -->
    <div class="card bg-base-100 shadow">
        <div class="card-body">
            <form method="GET" id="filterForm" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {% if show_only_score_gap %}
                <input type="hidden" name="score_ecart" value="1">
                {% endif %}
                <!-- Année -->
                <div class="form-control">
                    <label class="label"><span class="label-text">Année</span></label>
                    <select name="annee" class="select select-bordered" onchange="this.form.submit()">
                        <option value="2023" {% if annee_filter == "2023" %}selected{% endif %}>2023</option>
                        <option value="2024" {% if annee_filter == "2024" %}selected{% endif %}>2024</option>
                        <option value="2025" {% if annee_filter == "2025" %}selected{% endif %}>2025</option>
                        <option value="2026" {% if annee_filter == "2026" %}selected{% endif %}>2026</option>
                    </select>
                </div>

                <div class="form-control md:col-span-3 md:max-w-md">
                    <label class="label"><span class="label-text">Employé responsable</span></label>
                    <select name="employe" id="volumeGlobalEmployeSelect" class="select select-bordered">
                        <option value="">Tous les responsables</option>
                        {% for employe in employes_responsables %}
                        <option value="{{ employe.id }}" {% if employe.id == employe_filter %}selected{% endif %}>
                            {{ employe.label }} — {{ employe.poste }} ({{ employe.ouvrage_count }})
                        </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Régions (multi-sélection) -->
                <div class="form-control">
                    <label class="label"><span class="label-text">Régions</span></label>
                    <select name="regions" id="regionsSelect" class="select select-bordered" multiple size="3">
                        {% for region in regions %}
                        <option value="{{ region.id }}" data-employe-ids="{{ region.filter_employe_ids|default:'' }}"
                                {% if region.id|stringformat:"s" in regions_ids %}selected{% endif %}>
                            {{ region.nom_region }}
                        </option>
                        {% endfor %}
                    </select>
                    <label class="label">
                        <span class="label-text-alt">Ctrl/Cmd pour sélectionner plusieurs</span>
                    </label>
                </div>

                <!-- Districts (multi-sélection) -->
                <div class="form-control">
                    <label class="label"><span class="label-text">Districts</span></label>
                    <select name="districts" id="districtsSelect" class="select select-bordered" multiple size="3">
                        {% for district in districts %}
                        <option value="{{ district.id }}" data-region-id="{{ district.region_id }}"
                                data-employe-ids="{{ district.filter_employe_ids|default:'' }}"
                                {% if district.id|stringformat:"s" in districts_ids %}selected{% endif %}>
                            {{ district.nom_district }}
                        </option>
                        {% endfor %}
                    </select>
                    <label class="label">
                        <span class="label-text-alt">Ctrl/Cmd pour sélectionner plusieurs</span>
                    </label>
                </div>

                <!-- Communes (multi-sélection) -->
                <div class="form-control">
                    <label class="label"><span class="label-text">Communes</span></label>
                    <select name="communes" id="communesSelect" class="select select-bordered" multiple size="3">
                        {% for commune in communes %}
                        <option value="{{ commune.id }}" data-region-id="{{ commune.district.region_id }}"
                                data-district-id="{{ commune.district_id }}"
                                data-employe-ids="{{ commune.filter_employe_ids|default:'' }}"
                                {% if commune.id|stringformat:"s" in communes_ids %}selected{% endif %}>
                            {{ commune.nom_commune }}
                        </option>
                        {% endfor %}
                    </select>
                    <label class="label">
                        <span class="label-text-alt">Ctrl/Cmd pour sélectionner plusieurs</span>
                    </label>
                </div>

                <!-- Ouvrages (multi-sélection) -->
                <div class="form-control">
                    <label class="label"><span class="label-text">Ouvrages</span></label>
                    <select name="ouvrages" id="ouvragesSelect" class="select select-bordered" multiple size="3">
                        {% for ouvrage in ouvrages %}
                        <option value="{{ ouvrage.id }}" data-region-id="{{ ouvrage.filter_region_id|default:'' }}"
                                data-district-id="{{ ouvrage.filter_district_id|default:'' }}"
                                data-commune-id="{{ ouvrage.filter_commune_id|default:'' }}"
                                data-employe-ids="{{ ouvrage.filter_employe_ids|default:'' }}"
                                {% if ouvrage.id|stringformat:"s" in ouvrages_ids %}selected{% endif %}>
                            {{ ouvrage.nom_ouvrage }}
                        </option>
                        {% endfor %}
                    </select>
                    <label class="label">
                        <span class="label-text-alt">Ctrl/Cmd pour sélectionner plusieurs</span>
                    </label>
                </div>

                <!-- Boutons -->
                <div class="form-control flex flex-row gap-2 items-end">
                    <button type="submit" class="btn btn-primary flex-1">
                        <i class="fas fa-filter mr-2"></i>Filtrer
                    </button>
                    <button type="button" onclick="resetFilters()" class="btn btn-ghost flex-1">
                        <i class="fas fa-redo mr-2"></i>Réinitialiser
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Nouveau tableau: Taux de recouvrement mensuels par ouvrage -->
    <div class="card bg-base-100 shadow-xl mb-8">
        <div class="card-body">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <h2 class="card-title">
                    <i class="fas fa-calendar-alt text-info mr-2"></i>
                    Taux de Recouvrement Mensuels par Ouvrage ({{ annee_filter }})
                    <span class="badge badge-info badge-sm ml-2">Calcul depuis Table Relevés</span>
                </h2>
                <label class="label cursor-pointer gap-3 bg-base-200 px-3 py-2 rounded-lg border border-base-300">
                    <span class="label-text font-semibold text-sm">
                        <i class="fas fa-list-ul mr-1"></i>Afficher infos
                    </span>
                    <input type="checkbox" id="toggle-monthly-infos" class="toggle toggle-primary toggle-sm" onchange="toggleMonthlyInfos(this.checked)">
                </label>
            </div>
            <div class="overflow-x-auto">
                <table class="table table-sm table-zebra">
                    <thead class="sticky top-0 bg-base-200">
                        <tr>
                            <th class="sticky left-0 bg-base-200 z-10">Ouvrage</th>
                            {% for month in taux_mensuels_visible_months %}
                            <th class="text-center">{{ month.label }}</th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% if taux_mensuels_visible_months %}
                        {% for district_nom, ouvrages in taux_mensuels_par_district.items %}
                            <!-- En-tête du district -->
                            <tr class="bg-primary text-primary-content font-bold">
                                <td colspan="{{ taux_mensuels_visible_months|length|add:'1' }}" class="py-2">
                                    <i class="fas fa-map-marker-alt mr-2"></i>
                                    {{ district_nom }} ({{ ouvrages|length }} ouvrage{{ ouvrages|length|pluralize }})
                                </td>
                            </tr>
                            <!-- Ouvrages du district avec taux mensuels -->
                            {% for ouvrage_data in ouvrages %}
                            <tr class="hover">
                                <td class="pl-8 sticky left-0 bg-base-100 z-10 font-medium">{{ ouvrage_data.ouvrage_nom }}</td>
                                {% for month_item in ouvrage_data.visible_months %}
                                    <td class="text-center px-2 align-top">
                                        {% if month_item.data is not None %}
                                            <button
                                                type="button"
                                                class="clickable-month-cell w-full rounded-md px-1 py-1"
                                                title="Voir les details du mois"
                                                onclick="openReleveDetailsModal('{{ ouvrage_data.ouvrage_id }}', '{{ ouvrage_data.ouvrage_nom|escapejs }}', '{{ annee_filter }}', {{ month_item.number }})">
                                                <div class="flex flex-col items-center gap-1">
                                                    <!-- Barre de progression horizontale -->
                                                    <div class="w-full bg-base-200 rounded-full h-2 overflow-hidden">
                                                        <div class="h-full rounded-full transition-all
                                                            {% if month_item.data.taux >= 95 %}bg-success
                                                            {% elif month_item.data.taux >= 80 %}bg-warning
                                                            {% elif month_item.data.taux > 0 %}bg-error
                                                            {% else %}bg-base-300{% endif %}"
                                                            style="width: {{ month_item.data.taux }}%;">
                                                        </div>
                                                    </div>
                                                    <!-- Pourcentage en petit texte -->
                                                    <span class="text-xs font-semibold
                                                        {% if month_item.data.taux >= 95 %}text-success
                                                        {% elif month_item.data.taux >= 80 %}text-warning
                                                        {% elif month_item.data.taux > 0 %}text-error
                                                        {% else %}text-base-content/50{% endif %}">
                                                        {{ month_item.data.taux }}%
                                                    </span>
                                                    <div class="monthly-info-details hidden text-[10px] leading-none opacity-70 mt-1">
                                                        <div title="Montant total des relevés">Relevés: {{ month_item.data.total_releves|floatformat:0|intcomma }}</div>
                                                        <div title="Montant total payé (DiameX)" class="text-primary font-semibold">Payé: {{ month_item.data.total_diamex|floatformat:0|intcomma }}</div>
                                                        <div title="Ecart entre relevés et payé" class="{% if month_item.data.ecart != 0 %}text-warning font-semibold{% endif %}">Écart: {{ month_item.data.ecart|floatformat:0|intcomma }}</div>
                                                        <div title="Montant pointé côté relevés">Pointé relevé: {{ month_item.data.pointe_releve|floatformat:0|intcomma }}</div>
                                                        <div title="Montant pointé côté DiameX" class="text-success font-semibold">Pointé DiameX: {{ month_item.data.pointe_diamex|floatformat:0|intcomma }}</div>
                                                        {% if month_item.data.nb_non_recouvrable %}
                                                        <div title="Exclu du prévu, mais toujours pointable" class="font-semibold text-base-content/60">
                                                            Hors rec.: {{ month_item.data.montant_non_recouvrable|floatformat:0|intcomma }} ({{ month_item.data.nb_non_recouvrable }})
                                                        </div>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </button>
                                        {% else %}
                                            <span class="text-base-content/30">-</span>
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                            {% endfor %}
                        {% empty %}
                        <tr>
                            <td colspan="{{ taux_mensuels_visible_months|length|add:'1' }}" class="text-center text-base-content/50 py-8">
                                Aucune donnée disponible pour les filtres sélectionnés
                            </td>
                        </tr>
                        {% endfor %}
                        {% else %}
                        <tr>
                            <td colspan="1" class="text-center text-base-content/50 py-8">
                                Aucune donnée mensuelle disponible pour les filtres sélectionnés
                            </td>
                        </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
            <div class="mt-4 text-sm text-base-content/70">
                <i class="fas fa-info-circle mr-2"></i>
                Les barres de progression colorées indiquent le taux de recouvrement :
                <span class="inline-flex items-center gap-1 ml-2">
                    <div class="w-8 h-2 bg-success rounded-full"></div>
                    <span>≥ 95%</span>
                </span>
                <span class="inline-flex items-center gap-1 ml-2">
                    <div class="w-8 h-2 bg-warning rounded-full"></div>
                    <span>80-94%</span>
                </span>
                <span class="inline-flex items-center gap-1 ml-2">
                    <div class="w-8 h-2 bg-error rounded-full"></div>
                    <span>&lt; 80%</span>
                </span>
                <span class="inline-flex items-center gap-1 ml-2">
                    <span class="text-base-content/30">-</span>
                    <span>Pas de données</span>
                </span>
            </div>
        </div>
    </div>

    <!-- Tableau global -->
    <div class="card bg-base-100 shadow">
        <div class="card-body">
            <h2 class="card-title mb-4">
                <i class="fas fa-table text-primary mr-2"></i>
                Suivi Global des Paiements Volumétriques
                <span class="badge badge-primary badge-sm ml-2">Calcul depuis Comptabilité</span>
            </h2>
            <div class="overflow-x-auto">
                <table id="tableau-global-paiements" class="table table-xs table-pin-rows">
                    <thead>
                        <tr>
                            <th class="bg-base-200">Ouvrage</th>
                            <th class="bg-base-200 text-center">Type</th>
                            <th class="bg-base-200 text-center">Nb PE</th>
                            <th class="bg-base-200 text-center" title="Points d'eau coupés (datearretbranchement renseigné)">
                                <i class="fas fa-cut text-error mr-1"></i>Coupés
                            </th>
                            {% for mois_nom in mois_noms %}
                            <th class="text-center bg-base-200">{{ mois_nom }}</th>
                            {% endfor %}
                            <th class="bg-base-200 text-center">Total</th>
                            <th class="bg-base-200 text-center">Payés</th>
                            <th class="bg-base-200 text-center">Impayés</th>
                            <th class="bg-base-200 text-center">Taux</th>
                            <th class="bg-base-200">Action</th>
                        </tr>
