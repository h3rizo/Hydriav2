{% extends planning_shell_base_template %}
{% load humanize %}
{% load planning_extras %}

{% block content %}
<div class="space-y-6">
    <!-- En-tête -->
    <div class="flex justify-between items-center">
        <h1 class="text-3xl font-bold">{{ title }}</h1>
        <div class="flex gap-2">
            <a href="{% url 'planning:suivi_paiements_global' %}" class="btn btn-info btn-sm">
                <i class="fas fa-globe mr-2"></i>Vue Globale
            </a>
            <button onclick="document.getElementById('modal_impression_volumetrique').showModal()" class="btn btn-success btn-sm">
                <i class="fas fa-print mr-2"></i>Imprimer
            </button>
            <a href="{% url 'planning:gestion_volumetrique_details' %}" class="btn btn-ghost btn-sm">
                <i class="fas fa-list mr-2"></i>Vue détaillée
            </a>
        </div>
    </div>

    <!-- Stats -->
    <div class="stats shadow w-full grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 xl:grid-cols-7">
        <div class="stat">
            <div class="stat-figure text-info"><i class="fas fa-tint text-3xl"></i></div>
            <div class="stat-title">Points d'eau</div>
            <div class="stat-value text-info">{{ total_points_eau|intcomma }}</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-primary"><i class="fas fa-file-invoice text-3xl"></i></div>
            <div class="stat-title">Total Factures</div>
            <div class="stat-value text-primary">{{ stats.total_factures|intcomma }}</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-success"><i class="fas fa-check-circle text-3xl"></i></div>
            <div class="stat-title">Payées</div>
            <div class="stat-value text-success">{{ stats.factures_payees|intcomma }}</div>
            <div class="stat-desc">{{ stats.taux_paiement }}% du total</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-error"><i class="fas fa-times-circle text-3xl"></i></div>
            <div class="stat-title">Impayées</div>
            <div class="stat-value text-error">{{ stats.factures_impayees|intcomma }}</div>
        </div>
        <div class="stat bg-error/5">
            <div class="stat-figure text-error"><i class="fas fa-coins text-3xl"></i></div>
            <div class="stat-title">Montant non pointé</div>
            <div class="stat-value text-error text-2xl whitespace-nowrap">
                {{ stats.montant_impaye|floatformat:0|intcomma }} Ar
            </div>
            <div class="stat-desc">Période affichée</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-success"><i class="fas fa-check-double text-3xl"></i></div>
            <div class="stat-title">Tout payé</div>
            <div class="stat-value text-success">{{ stats.points_eau_tout_paye|intcomma }}</div>
            <div class="stat-desc">0 impayé</div>
        </div>
        <div class="stat">
            <div class="stat-figure text-warning"><i class="fas fa-exclamation-triangle text-3xl"></i></div>
            <div class="stat-title">À risque</div>
            <div class="stat-value text-warning">{{ stats.points_eau_coupes|intcomma }}</div>
            <div class="stat-desc">≥2 impayés consécutifs</div>
        </div>
    </div>

    <!-- Filtres -->
    <div class="card bg-base-100 shadow">
        <div class="card-body">
            <form method="GET" id="filterForm" class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <!-- Année -->
                <div class="form-control">
                    <label class="label"><span class="label-text">Année</span></label>
                    <select name="annee" class="select select-bordered" onchange="this.form.submit()">
                        <option value="2023" {% if annee_filter == "2023" %}selected{% endif %}>2023</option>
                        <option value="2024" {% if annee_filter == "2024" %}selected{% endif %}>2024</option>
                        <option value="2025" {% if annee_filter == "2025" %}selected{% endif %}>2025</option>
                        <option value="2026" {% if annee_filter == "2026" %}selected{% endif %}>2026</option>
                    </select>
                </div>

                <!-- Commune -->
                <div class="form-control">
                    <label class="label"><span class="label-text">Commune</span></label>
                    <select name="commune" class="select select-bordered" onchange="this.form.submit()">
                        <option value="all">Toutes</option>
                        {% for commune in communes %}
                        <option value="{{ commune.id }}" {% if commune_id == commune.id|stringformat:"s" %}selected{% endif %}>
                            {{ commune.nom_commune }}
                        </option>
                        {% endfor %}
                    </select>
                </div>
                <!-- Ouvrage avec autocomplétion -->
                <div class="form-control">
                    <label class="label">
                        <span class="label-text">Ouvrage <span class="text-error">*</span></span>
                    </label>
                    <select name="ouvrage" id="ouvrageSelect" class="select select-bordered" required>
                        <option value="">-- Sélectionner un ouvrage --</option>
                        {% for ouvrage in ouvrages %}
                        <option value="{{ ouvrage.id }}" {% if ouvrage_id == ouvrage.id|stringformat:"s" %}selected{% endif %}>
                            {{ ouvrage.nom_ouvrage }}
                        </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Type de point d'eau -->
                <div class="form-control">
                    <label class="label">
                        <span class="label-text">Type de point d'eau</span>
                    </label>
                    <select name="type_point_eau" class="select select-bordered">
                        <option value="all" {% if not type_point_eau_id or type_point_eau_id == 'all' %}selected{% endif %}>Tous les types</option>
                        {% for type_pe in types_points_eau %}
                        <option value="{{ type_pe.id }}" {% if type_point_eau_id == type_pe.id|stringformat:"s" %}selected{% endif %}>
                            {{ type_pe.nom_type }}
                        </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Bouton -->
                <div class="form-control flex justify-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-filter mr-2"></i>Filtrer
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Message si aucun ouvrage sélectionné -->
    {% if not ouvrage_selectionne %}
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i>
        <div>
            <h3 class="font-bold">Sélectionnez un ouvrage</h3>
            <div class="text-sm">Veuillez sélectionner un ouvrage dans les filtres ci-dessus pour afficher le tableau de suivi des paiements.</div>
        </div>
    </div>
    {% else %}
    <!-- Tableau matriciel avec regroupement par parcelle -->
    <div class="card bg-base-100 shadow">
        <div class="card-body p-0">
            <div class="overflow-x-auto">
                <table class="table table-xs table-pin-rows">
                    <thead>
                        <tr>
                            <th class="bg-base-200 sticky left-0 z-10">ID</th>
                            <th class="bg-base-200">Abonné</th>
                            <th class="bg-base-200 text-center">Type</th>
                            {% for mois_nom in mois_noms %}
                            <th class="text-center bg-base-200">{{ mois_nom }}</th>
                            {% endfor %}
                            <th class="bg-base-200 text-center">Relevés</th>
                            <th class="bg-base-200 text-center">Payés</th>
                            <th class="bg-base-200 text-center">Impayés</th>
                            <th class="bg-base-200 text-center">Taux</th>
                            <th class="bg-base-200">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for parcelle in parcelles_organisees %}
                            <!-- Ligne en-tête parcelle -->
                            <tr>
                                <td colspan="{{ mois_liste|length|add:'8' }}" class="bg-primary text-primary-content px-3 py-2 font-bold text-sm">
                                    <i class="fas fa-layer-group mr-2"></i>{{ parcelle.parcelle_nom }}
                                </td>
                            </tr>

                            <!-- Points d'eau de la parcelle -->
                            {% for data in parcelle.points_eau %}
                            <tr class="hover {% if data.est_coupe %}bg-warning/10{% endif %}">
                                <td class="font-mono text-xs font-semibold sticky left-0 {% if data.est_coupe %}bg-warning/10{% else %}bg-base-100{% endif %}">
                                    {{ data.point_eau.idxls|default:"-" }}
                                    {% if data.est_coupe %}
                                    <i class="fas fa-exclamation-triangle text-warning ml-1" title="Point d'eau à risque de coupure"></i>
                                    {% endif %}
                                </td>
                                <td class="text-xs">
                                    {{ data.point_eau.nomabonne|default:"-" }}
                                    {% if data.point_eau.datearretbranchement %}
                                        <span class="tooltip tooltip-error" data-tip="Point d'eau coupé le {{ data.point_eau.datearretbranchement|date:'d/m/Y' }}">
                                            <i class="fas fa-cut text-error ml-1"></i>
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    {% with type_nom=data.point_eau.type_point_eau.nom_type|upper %}
                                        {% if 'KIOSQUE' in type_nom %}
                                            <i class="fas fa-store text-info text-lg" title="{{ data.point_eau.type_point_eau.nom_type }}"></i>
                                        {% elif 'BI' in type_nom or 'BORNE' in type_nom %}
                                            <i class="fas fa-faucet text-primary text-lg" title="{{ data.point_eau.type_point_eau.nom_type }}"></i>
                                        {% elif 'BP' in type_nom or 'BRANCHEMENT' in type_nom or 'PRIVÉ' in type_nom or 'PRIVE' in type_nom %}
                                            <i class="fas fa-home text-success text-lg" title="{{ data.point_eau.type_point_eau.nom_type }}"></i>
                                        {% else %}
                                            <i class="fas fa-tint text-base-content/50 text-lg" title="{{ data.point_eau.type_point_eau.nom_type|default:'Type inconnu' }}"></i>
                                        {% endif %}
                                    {% endwith %}
                                </td>

                                <!-- Colonnes mois -->
                                {% for mois in mois_liste %}
                                <td class="text-center p-1">
                                    {% with mois_data=data.mois|lookup:mois %}
                                        {% if mois_data.releve_id %}
                                            {% if mois_data.non_recouvrable %}
                                                <span class="badge badge-neutral badge-sm w-full font-semibold whitespace-nowrap"
                                                      title="Hors recouvrement, mais pointage toujours possible — {{ mois_data.montant|floatformat:0|intcomma }} Ar">
                                                    HR
                                                </span>
                                            {% elif mois_data.paye %}
                                                <span class="badge badge-success badge-sm w-full" title="Payé le {{ mois_data.date_releve }} - {{ mois_data.montant|floatformat:0 }} Ar">
                                                    <i class="fas fa-check"></i>
                                                </span>
                                            {% else %}
                                                <span class="badge badge-error badge-sm w-full font-semibold whitespace-nowrap"
                                                      title="Non pointé - {{ mois_data.montant|floatformat:0|intcomma }} Ar - {{ mois_data.date_releve }}">
                                                    {{ mois_data.montant|floatformat:0|intcomma }}
                                                </span>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-base-content/20">-</span>
                                        {% endif %}
                                    {% endwith %}
                                </td>
                                {% endfor %}

                                <!-- Stats -->
                                <td class="text-center">
                                    <span class="badge badge-info badge-sm" title="{{ data.nb_non_recouvrables }} facture(s) hors recouvrement">{{ data.nb_releves }}</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-success badge-sm">{{ data.nb_payes }}</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-error badge-sm">{{ data.nb_impayes }}</span>
                                </td>
                                <td class="text-center">
                                    <span class="font-semibold {% if data.taux >= 80 %}text-success{% elif data.taux >= 50 %}text-warning{% else %}text-error{% endif %}">
                                        {{ data.taux }}%
                                    </span>
                                </td>

                                <!-- Actions -->
                                <td>
                                    <div class="flex gap-1">
                                        <a href="{% url 'planning:gestion_volumetrique_details' %}?point_eau={{ data.point_eau.id }}&annee={{ annee_filter }}"
                                           class="btn btn-ghost btn-xs text-primary"
                                           title="Voir détails">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <div class="dropdown dropdown-end">
                                            <label tabindex="0" class="btn btn-ghost btn-xs text-error" title="Coupure/Remise">
                                                <i class="fas fa-cut"></i>
                                            </label>
                                            <ul tabindex="0" class="dropdown-content menu p-2 shadow bg-base-100 rounded-box w-64 z-50">
                                                {% if data.point_eau.datearretbranchement %}
                                                    <li><a onclick="ouvrirModalRemiseDirect('{{ data.point_eau.id }}', '{{ data.point_eau.nomabonne|escapejs }}', '{{ data.point_eau.datearretbranchement|date:"Y-m-d" }}')">
                                                        <i class="fas fa-power-off text-success"></i>Remettre en service
                                                    </a></li>
                                                    <li class="disabled"><a class="text-base-content/50">
                                                        <i class="fas fa-info-circle text-warning"></i>Coupé le {{ data.point_eau.datearretbranchement|date:"d/m/Y" }}
                                                    </a></li>
                                                {% else %}
                                                    <li><a onclick="ouvrirModalCoupureDirect('{{ data.point_eau.id }}', '{{ data.point_eau.nomabonne|escapejs }}', '{{ data.point_eau.ouvrage.id }}', '{{ data.point_eau.ouvrage.nom_ouvrage|escapejs }}')">
                                                        <i class="fas fa-cut text-error"></i>Couper ce point d'eau
                                                    </a></li>
                                                {% endif %}
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        {% empty %}
                        <tr>
                            <td colspan="{{ mois_liste|length|add:'8' }}" class="text-center py-8 text-base-content/50">
                                <i class="fas fa-inbox text-4xl mb-2"></i>
                                <p>Aucun point d'eau trouvé</p>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Légende -->
    <div class="alert">
        <i class="fas fa-info-circle"></i>
        <div class="w-full">
            <p class="font-semibold mb-2">Légende</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                <div>
                    <p class="font-medium mb-1">Types de points d'eau :</p>
                    <div class="flex flex-col gap-1 ml-2">
                        <span><i class="fas fa-store text-info mr-2"></i> Kiosque</span>
                        <span><i class="fas fa-faucet text-primary mr-2"></i> Borne Individuelle (BI)</span>
                        <span><i class="fas fa-home text-success mr-2"></i> Branchement Privé (BP)</span>
                        <span><i class="fas fa-tint text-base-content/50 mr-2"></i> Autre type</span>
                    </div>
                </div>
                <div>
                    <p class="font-medium mb-1">Statuts de paiement :</p>
                    <div class="flex flex-col gap-1 ml-2">
                        <span><i class="fas fa-check text-success mr-2"></i> Payé (numeroDiameX renseigné)</span>
                        <span><i class="fas fa-times text-error mr-2"></i> Non payé</span>
                        <span class="text-base-content/40 mr-2">- Pas de relevé</span>
                        <span class="badge badge-warning badge-sm"><i class="fas fa-exclamation-triangle mr-1"></i> Point d'eau à risque (≥2 impayés consécutifs)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<!-- Modal de sélection d'ouvrage pour l'impression -->
<dialog id="modal_impression_volumetrique" class="modal">
    <div class="modal-box max-w-2xl">
        <h3 class="font-bold text-lg mb-4">
            <i class="fas fa-print mr-2"></i>Sélectionner l'ouvrage à imprimer
        </h3>

        <form method="dialog" class="mb-4">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
        </form>

        <!-- Filtres année et commune -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
            <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Année</span></label>
                <select id="annee_impression" class="select select-bordered select-sm">
                    <option value="2023" {% if annee_filter == "2023" %}selected{% endif %}>2023</option>
                    <option value="2024" {% if annee_filter == "2024" %}selected{% endif %}>2024</option>
                    <option value="2025" {% if annee_filter == "2025" %}selected{% endif %}>2025</option>
                    <option value="2026" {% if annee_filter == "2026" %}selected{% endif %}>2026</option>
                </select>
            </div>

            <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Période</span></label>
                <select id="semestre_impression" class="select select-bordered select-sm">
                    <option value="all">Année complète</option>
                    <option value="1">1er semestre (janvier à juin)</option>
                    <option value="2">2e semestre (juillet à décembre)</option>
                </select>

                <label class="label cursor-pointer justify-start gap-3 mt-3">
                    <input type="checkbox" id="non_pointes_totalement_impression"
                           class="checkbox checkbox-warning checkbox-sm">
                    <span class="label-text">Seulement les points d'eau non totalement pointés</span>
                </label>
            </div>

            <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Communes (facultatif)</span></label>

                <div class="form-control mb-2">
                    <label class="label cursor-pointer justify-start gap-3">
                        <input type="checkbox" class="checkbox checkbox-primary checkbox-sm" value="all"
                               onchange="toggleToutesCommunesVolume(this)" checked>
                        <span class="label-text font-semibold">Toutes les communes</span>
                    </label>
                </div>

                <div class="divider my-1"></div>

                <div class="max-h-64 overflow-y-auto border rounded-lg p-2">
                    {% regroup communes by district as communes_by_district %}
                    {% for district_group in communes_by_district %}
                    <div class="mb-3">
                        <div class="font-bold text-sm text-primary mb-1 sticky top-0 bg-base-100 py-1">
                            <i class="fas fa-map-marker-alt mr-1"></i>{{ district_group.grouper.nom_district }}
                        </div>
                        <div class="grid grid-cols-1 gap-1 ml-4">
                            {% for commune in district_group.list %}
                            <div class="form-control">
                                <label class="label cursor-pointer justify-start gap-2 py-1">
                                    <input type="checkbox" name="communes_impression"
                                           value="{{ commune.id }}" class="checkbox checkbox-sm" checked>
                                    <span class="label-text text-sm">{{ commune.nom_commune }}</span>
                                </label>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="modal-action">
            <button type="button" onclick="ouvrirImpressionAvecOuvrage()" class="btn btn-success">
                <i class="fas fa-print mr-2"></i>Imprimer
            </button>
            <button type="button" onclick="document.getElementById('modal_impression_volumetrique').close()" class="btn btn-ghost">
                Annuler
            </button>
        </div>
    </div>
</dialog>

<!-- Modal Coupure Direct -->
<dialog id="modalCoupureDirect" class="modal">
    <div class="modal-box w-11/12 max-w-2xl">
        <h3 class="font-bold text-lg text-error">
            <i class="fas fa-cut mr-2"></i>Couper un Point d'Eau
        </h3>

        <div class="py-4">
            <div class="alert alert-warning mb-4">
                <i class="fas fa-exclamation-triangle"></i>
                <span>Cette action définira la date d'arrêt du branchement. Les relevés après cette date ne seront plus facturés.</span>
            </div>

            <form id="formCoupureDirect" class="space-y-4">
                <div class="form-control">
                    <label class="label"><span class="label-text font-semibold">Ouvrage</span></label>
                    <input type="text" id="coupure-direct-ouvrage-nom" class="input input-bordered" readonly>
                    <input type="hidden" id="coupure-direct-ouvrage-id">
                </div>

                <div class="form-control">
                    <label class="label"><span class="label-text font-semibold">Point d'eau</span></label>
                    <input type="text" id="coupure-direct-point-eau-nom" class="input input-bordered" readonly>
                    <input type="hidden" id="coupure-direct-point-eau-id">
                </div>

                <div class="form-control">
                    <label class="label"><span class="label-text font-semibold">Date de coupure *</span></label>
                    <input type="date" id="coupure-direct-date" class="input input-bordered" required>
                </div>

                <div class="form-control">
                    <label class="label"><span class="label-text">Motif (optionnel)</span></label>
                    <textarea id="coupure-direct-motif" class="textarea textarea-bordered" rows="3" placeholder="Ex: Impayés depuis 3 mois"></textarea>
                </div>
            </form>
        </div>

        <div class="modal-action">
            <button type="button" onclick="validerCoupureDirect()" class="btn btn-error">
                <i class="fas fa-cut mr-2"></i>Valider la coupure
            </button>
            <button type="button" onclick="document.getElementById('modalCoupureDirect').close()" class="btn btn-ghost">
                Annuler
            </button>
        </div>
    </div>
</dialog>

<!-- Modal Remise Direct -->
<dialog id="modalRemiseDirect" class="modal">
    <div class="modal-box w-11/12 max-w-2xl">
        <h3 class="font-bold text-lg text-success">
            <i class="fas fa-power-off mr-2"></i>Remettre en Service un Point d'Eau
        </h3>

        <div class="py-4">
            <div class="alert alert-success mb-4">
                <i class="fas fa-check-circle"></i>
                <span>Cette action supprimera la date d'arrêt. Le point d'eau sera à nouveau facturé.</span>
            </div>

            <form id="formRemiseDirect" class="space-y-4">
                <div class="form-control">
                    <label class="label"><span class="label-text font-semibold">Point d'eau</span></label>
                    <input type="text" id="remise-direct-point-eau-nom" class="input input-bordered" readonly>
                    <input type="hidden" id="remise-direct-point-eau-id">
                </div>

                <div class="form-control">
                    <label class="label"><span class="label-text">Date de coupure actuelle</span></label>
                    <input type="text" id="remise-direct-date-coupure" class="input input-bordered" readonly>
                </div>

                <div class="form-control">
                    <label class="label"><span class="label-text font-semibold">Date de remise *</span></label>
                    <input type="date" id="remise-direct-date" class="input input-bordered" required>
                </div>

                <div class="form-control">
                    <label class="label"><span class="label-text">Motif (optionnel)</span></label>
                    <textarea id="remise-direct-motif" class="textarea textarea-bordered" rows="3" placeholder="Ex: Paiement régularisé"></textarea>
                </div>
            </form>
        </div>

        <div class="modal-action">
            <button type="button" onclick="validerRemiseDirect()" class="btn btn-success">
                <i class="fas fa-power-off mr-2"></i>Valider la remise en service
            </button>
            <button type="button" onclick="document.getElementById('modalRemiseDirect').close()" class="btn btn-ghost">
                Annuler
            </button>
        </div>
    </div>
</dialog>

<!-- Custom filter pour accéder aux dictionnaires -->
{% endblock %}

{% block extra_js %}
<script>
// Autocomplétion pour le filtre Ouvrage avec recherche en temps réel
document.addEventListener('DOMContentLoaded', function() {
    const ouvrageSelect = document.getElementById('ouvrageSelect');

    // Ajouter un champ de recherche au-dessus du select
    const formControl = ouvrageSelect.closest('.form-control');
    const searchWrapper = document.createElement('div');
    searchWrapper.className = 'relative';

    const searchInput = document.createElement('input');
    searchInput.type = 'text';
    searchInput.className = 'input input-bordered w-full mb-2';
    searchInput.placeholder = 'Rechercher un ouvrage...';
    searchInput.id = 'ouvrageSearch';

    searchWrapper.appendChild(searchInput);
    formControl.insertBefore(searchWrapper, ouvrageSelect);

    // Fonction de recherche avec debounce
    let searchTimeout;
    searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        const query = this.value.trim();

        if (query.length < 2) {
            return;
        }

        searchTimeout = setTimeout(() => {
            fetch(`{% url 'planning:api_ouvrages_autocomplete' %}?q=${encodeURIComponent(query)}`)
                .then(response => response.json())
                .then(data => {
                    // Mettre à jour le select avec les résultats
                    const currentValue = ouvrageSelect.value;
                    ouvrageSelect.innerHTML = '<option value="all">Tous</option>';

                    data.results.forEach(ouvrage => {
                        const option = document.createElement('option');
                        option.value = ouvrage.id;
                        option.textContent = ouvrage.text;
                        if (currentValue === ouvrage.id) {
                            option.selected = true;
                        }
                        ouvrageSelect.appendChild(option);
                    });
                })
                .catch(error => console.error('Erreur autocomplétion:', error));
        }, 300);
    });

    // Soumettre le formulaire quand on change l'ouvrage
    ouvrageSelect.addEventListener('change', function() {
        document.getElementById('filterForm').submit();
    });
});

// Fonction pour ouvrir la page d'impression avec l'ouvrage sélectionné
function ouvrirImpressionAvecOuvrage() {
    // Récupérer l'ouvrage du filtre principal de la page
    const ouvrageSelect = document.getElementById('ouvrageSelect');
    const ouvrage = ouvrageSelect ? ouvrageSelect.value : '';

    if (!ouvrage || ouvrage === 'all') {
        alert('Veuillez d\'abord sélectionner un ouvrage dans les filtres de la page');
        document.getElementById('modal_impression_volumetrique').close();
        return;
    }

    const annee = document.getElementById('annee_impression').value;
    const semestre = document.getElementById('semestre_impression').value;
    const nonPointesTotalement = document.getElementById('non_pointes_totalement_impression').checked;

    // Récupérer les communes sélectionnées (checkboxes)
    const checkboxes = document.querySelectorAll('input[name="communes_impression"]:checked:not([value="all"])');
    const communesIds = Array.from(checkboxes).map(cb => cb.value);

    const urlParams = new URLSearchParams();
    urlParams.set('annee', annee);
    urlParams.set('ouvrage', ouvrage);
    urlParams.set('semestre', semestre);

    if (nonPointesTotalement) {
        urlParams.set('non_pointes_totalement', '1');
    }

    // Ajouter les communes si au moins une est sélectionnée
    if (communesIds.length > 0) {
        urlParams.set('communes', communesIds.join(','));
    }

    const url = "{% url 'planning:impression_gestion_volumetrique' %}?" + urlParams.toString();
    window.open(url, '_blank', 'width=1400,height=900,toolbar=yes,scrollbars=yes');
    document.getElementById('modal_impression_volumetrique').close();
}

// Toggle sélection toutes communes pour le modal volumétrique
function toggleToutesCommunesVolume(checkbox) {
    const checkboxes = document.querySelectorAll('input[name="communes_impression"]:not([value="all"])');
    checkboxes.forEach(cb => cb.checked = checkbox.checked);
}

// ============== FONCTIONS COUPURE/REMISE DIRECTE ==============

// Helper pour obtenir le CSRF token
function getCookie(name) {
    let cookieValue = null;
    if (document.cookie && document.cookie !== '') {
        const cookies = document.cookie.split(';');
        for (let i = 0; i < cookies.length; i++) {
            const cookie = cookies[i].trim();
            if (cookie.substring(0, name.length + 1) === (name + '=')) {
                cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                break;
            }
        }
    }
    return cookieValue;
}

// Ouvrir modal coupure avec données pré-remplies
function ouvrirModalCoupureDirect(pointEauId, pointEauNom, ouvrageId, ouvrageNom) {
    document.getElementById('coupure-direct-point-eau-id').value = pointEauId;
    document.getElementById('coupure-direct-point-eau-nom').value = pointEauNom;
    document.getElementById('coupure-direct-ouvrage-id').value = ouvrageId;
    document.getElementById('coupure-direct-ouvrage-nom').value = ouvrageNom;

    // Date par défaut = aujourd'hui
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('coupure-direct-date').value = today;

    document.getElementById('coupure-direct-motif').value = '';

    document.getElementById('modalCoupureDirect').showModal();
}

// Ouvrir modal remise avec données pré-remplies
function ouvrirModalRemiseDirect(pointEauId, pointEauNom, dateCoupure) {
    document.getElementById('remise-direct-point-eau-id').value = pointEauId;
    document.getElementById('remise-direct-point-eau-nom').value = pointEauNom;

    // Formater la date de coupure pour affichage
    const dateCoupureObj = new Date(dateCoupure);
    const formatted = dateCoupureObj.toLocaleDateString('fr-FR');
    document.getElementById('remise-direct-date-coupure').value = formatted;

    // Date par défaut = aujourd'hui
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('remise-direct-date').value = today;

    document.getElementById('remise-direct-motif').value = '';

    document.getElementById('modalRemiseDirect').showModal();
}

// Valider la coupure
async function validerCoupureDirect() {
    const pointEauId = document.getElementById('coupure-direct-point-eau-id').value;
    const dateCoupure = document.getElementById('coupure-direct-date').value;
    const motif = document.getElementById('coupure-direct-motif').value;

    if (!pointEauId || !dateCoupure) {
        alert('Veuillez remplir tous les champs obligatoires');
        return;
    }

    if (!confirm('Confirmer la coupure de ce point d\'eau ?')) {
        return;
    }

    try {
        const response = await fetch('{% url "billing:api_couper_point_eau" %}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': getCookie('csrftoken')
            },
            body: JSON.stringify({
                point_eau_id: pointEauId,
                date_coupure: dateCoupure,
                motif: motif
            })
        });

        const data = await response.json();

        if (data.success) {
            alert('✓ ' + data.message);
            document.getElementById('modalCoupureDirect').close();
            location.reload(); // Recharger pour voir la mise à jour
        } else {
            alert('Erreur: ' + data.error);
        }
    } catch (error) {
        console.error('Erreur:', error);
        alert('Erreur réseau: ' + error.message);
    }
}

