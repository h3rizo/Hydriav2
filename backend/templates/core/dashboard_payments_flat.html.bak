{% extends 'base.html' %}
{% load static %}
{% load humanize %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-6">
    <!-- En-tête -->
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-bold">
                <i class="fas fa-money-bill-wave text-success mr-3"></i>
                Tableau de bord Paiements Forfaitaires
            </h1>
            <p class="text-base-content/70 mt-2">
                <i class="fas fa-calendar mr-1"></i>Année : <span class="font-semibold">{{ annee_filter }}</span> - Vue
                consolidée par point d'eau avec statuts de paiement
            </p>
        </div>
        <div class="flex gap-2 items-center">
            <!-- Sélecteur d'année -->
            <div class="form-control">
                <select name="annee_select" id="annee_select" class="select select-bordered select-sm"
                    onchange="changeAnnee(this.value)">
                    {% for annee in annees_disponibles %}
                    <option value="{{ annee }}" {% if annee_filter==annee|stringformat:"s" %}selected{% endif %}>
                        {{ annee }}
                    </option>
                    {% endfor %}
                </select>
            </div>
            <button onclick="document.getElementById('modal_impression').showModal()" class="btn btn-success btn-sm">
                <i class="fas fa-print mr-2"></i>Imprimer
            </button>
            <a href="{% url 'core:dashboard_payments_flat_kanban' %}" class="btn btn-info btn-sm">
                <i class="fas fa-columns mr-2"></i>Vue Kanban
            </a>
            <a href="{% url 'planning:gestion_forfaitaire' %}" class="btn btn-primary btn-sm">
                <i class="fas fa-table mr-2"></i>Tableau détaillé
            </a>
        </div>
    </div>

    <!-- Filtres -->
    <form method="GET" class="card bg-base-100 shadow-xl mb-6">
        <div class="card-body">
            <h2 class="card-title text-lg mb-4">
                <i class="fas fa-filter mr-2"></i>Filtres
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Filtre Commune -->
                <div class="form-control">
                    <label class="label"><span class="label-text">Commune</span></label>
                    <select name="commune" class="select select-bordered select-sm">
                        <option value="">Toutes les communes</option>
                        {% for commune in communes %}
                        <option value="{{ commune.id }}" {% if commune.id|stringformat:"s"==commune_filter %}selected{%
                            endif %}>
                            {{ commune.nom_commune }}
                        </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Filtre Ouvrage -->
                <div class="form-control">
                    <label class="label"><span class="label-text">Ouvrage</span></label>
                    <select name="ouvrage" class="select select-bordered select-sm">
                        <option value="">Tous les ouvrages</option>
                        {% for ouvrage in ouvrages %}
                        <option value="{{ ouvrage.id }}" {% if ouvrage.id|stringformat:"s"==ouvrage_filter %}selected{%
                            endif %}>
                            {{ ouvrage.nom_ouvrage }}
                        </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Filtre Type Point d'eau -->
                <div class="form-control">
                    <label class="label"><span class="label-text">Type Point d'eau</span></label>
                    <select name="type_point_eau" class="select select-bordered select-sm">
                        <option value="">Tous les types</option>
                        {% for type_pe in types_point_eau %}
                        <option value="{{ type_pe.id }}" {% if type_pe.id|stringformat:"s"==type_point_eau_filter
                            %}selected{% endif %}>
                            {{ type_pe.nom_type }}
                        </option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                <!-- Filtre Année -->
                <div class="form-control">
                    <label class="label"><span class="label-text font-semibold">Année *</span></label>
                    <select name="annee" class="select select-bordered select-sm">
                        <option value="2020" {% if annee_filter=="2020" %}selected{% endif %}>2020</option>
                        <option value="2021" {% if annee_filter=="2021" %}selected{% endif %}>2021</option>
                        <option value="2022" {% if annee_filter=="2022" %}selected{% endif %}>2022</option>
                        <option value="2023" {% if annee_filter=="2023" %}selected{% endif %}>2023</option>
                        <option value="2024" {% if annee_filter=="2024" %}selected{% endif %}>2024</option>
                        <option value="2025" {% if annee_filter=="2025" %}selected{% endif %}>2025</option>
                        <option value="2026" {% if annee_filter=="2026" %}selected{% endif %}>2026</option>
                        <option value="2027" {% if annee_filter=="2027" %}selected{% endif %}>2027</option>
                        <option value="2028" {% if annee_filter=="2028" %}selected{% endif %}>2028</option>
                        <option value="2029" {% if annee_filter=="2029" %}selected{% endif %}>2029</option>
                        <option value="2030" {% if annee_filter=="2030" %}selected{% endif %}>2030</option>
                    </select>
                </div>

                <!-- Filtre Statut -->
                <div class="form-control">
                    <label class="label"><span class="label-text">Statut</span></label>
                    <select name="statut" class="select select-bordered select-sm">
                        <option value="">Tous les statuts</option>
                        <option value="tout_paye" {% if statut_filter=='tout_paye' %}selected{% endif %}>Tout payé
                        </option>
                        <option value="partiellement_paye" {% if statut_filter=='partiellement_paye' %}selected{% endif
                            %}>Partiellement payé</option>
                        <option value="non_paye" {% if statut_filter=='non_paye' %}selected{% endif %}>Non payé</option>
                        <option value="coupe" {% if statut_filter=='coupe' %}selected{% endif %}>Coupé</option>
                    </select>
                </div>

                <!-- Date début -->
                <div class="form-control">
                    <label class="label"><span class="label-text">Date début</span></label>
                    <input type="date" name="date_debut" value="{{ date_debut }}" class="input input-bordered input-sm">
                </div>

                <!-- Date fin -->
                <div class="form-control">
                    <label class="label"><span class="label-text">Date fin</span></label>
                    <input type="date" name="date_fin" value="{{ date_fin }}" class="input input-bordered input-sm">
                </div>
            </div>

            <div class="flex items-center gap-4 mt-4">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fas fa-search mr-2"></i>Filtrer
                </button>

                <a href="{% url 'core:dashboard_payments_flat' %}" class="btn btn-ghost btn-sm">
                    <i class="fas fa-times mr-2"></i>Réinitialiser
                </a>
            </div>
        </div>
    </form>

    <!-- Statistiques globales -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <!-- Total Points d'eau -->
        <div class="stats shadow">
            <div class="stat">
                <div class="stat-figure text-primary">
                    <i class="fas fa-tint text-3xl"></i>
                </div>
                <div class="stat-title">Points d'eau</div>
                <div class="stat-value text-primary">{{ nb_points_eau }}</div>
                <div class="stat-desc">Avec tarif forfaitaire</div>
            </div>
        </div>

        <!-- Paiement Prévu -->
        <div class="stats shadow">
            <div class="stat">
                <div class="stat-figure text-info">
                    <i class="fas fa-calendar-check text-3xl"></i>
                </div>
                <div class="stat-title">Paiement Prévu</div>
                <div class="stat-value text-info">{{ montant_prevu_k|intcomma }} K</div>
                <div class="stat-desc">{{ montant_prevu|floatformat:0|intcomma }} Ar</div>
            </div>
        </div>

        <!-- Paiement Payé -->
        <div class="stats shadow">
            <div class="stat">
                <div class="stat-figure text-success">
                    <i class="fas fa-check-circle text-3xl"></i>
                </div>
                <div class="stat-title">Paiement Payé</div>
                <div class="stat-value text-success">{{ montant_paye_k|intcomma }} K</div>
                <div class="stat-desc">{{ montant_paye|floatformat:0|intcomma }} Ar</div>
            </div>
        </div>

        <!-- Taux de Recouvrement -->
        <div class="stats shadow">
            <div class="stat">
                <div class="stat-figure text-primary">
                    <div class="radial-progress text-primary" style="--value:{{ taux_recouvrement }};"
                        role="progressbar">{{ taux_recouvrement }}%</div>
                </div>
                <div class="stat-title">Taux Recouvrement</div>
                <div class="stat-value text-primary">{{ taux_recouvrement }}%</div>
                <div class="stat-desc">Payé / Prévu</div>
            </div>
        </div>
    </div>

    <!-- Répartition par statut -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
        <!-- Répartition nombre -->
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
                <h3 class="card-title text-lg">
                    <i class="fas fa-chart-pie mr-2"></i>Répartition par statut
                </h3>
                <div class="grid grid-cols-2 gap-3 mt-4">
                    <div class="stats shadow cursor-pointer hover:shadow-lg transition-shadow"
                        onclick="filterByStatus('tout_paye')">
                        <div class="stat p-3">
                            <div class="stat-title text-xs">Tout Payé</div>
                            <div class="stat-value text-success text-2xl">{{ nb_tout_paye }}</div>
                            <div class="stat-desc text-xs">
                                {% widthratio nb_tout_paye nb_points_eau 100 %}%
                            </div>
                        </div>
                    </div>

                    <div class="stats shadow cursor-pointer hover:shadow-lg transition-shadow"
                        onclick="filterByStatus('partiellement_paye')">
                        <div class="stat p-3">
                            <div class="stat-title text-xs">Partiellement</div>
                            <div class="stat-value text-warning text-2xl">{{ nb_partiellement_paye }}</div>
                            <div class="stat-desc text-xs">
                                {% widthratio nb_partiellement_paye nb_points_eau 100 %}%
                            </div>
                        </div>
                    </div>

                    <div class="stats shadow cursor-pointer hover:shadow-lg transition-shadow"
                        onclick="filterByStatus('non_paye')">
                        <div class="stat p-3">
                            <div class="stat-title text-xs">Non Payé</div>
                            <div class="stat-value text-2xl">{{ nb_non_paye }}</div>
                            <div class="stat-desc text-xs">
                                {% widthratio nb_non_paye nb_points_eau 100 %}%
                            </div>
                        </div>
                    </div>

                    <div class="stats shadow cursor-pointer hover:shadow-lg transition-shadow"
                        onclick="filterByStatus('coupe')">
                        <div class="stat p-3">
                            <div class="stat-title text-xs">Coupé</div>
                            <div class="stat-value text-error text-2xl">{{ nb_coupe }}</div>
                            <div class="stat-desc text-xs">
                                {% widthratio nb_coupe nb_points_eau 100 %}%
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Graphique pourcentage -->
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
                <h3 class="card-title text-lg">
                    <i class="fas fa-percentage mr-2"></i>Pourcentages par statut
                </h3>
                <div class="flex flex-col gap-3 mt-4">
                    <!-- Tout payé -->
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-success font-semibold">Tout Payé</span>
                            <span class="badge badge-success">{% widthratio nb_tout_paye nb_points_eau 100 %}%</span>
                        </div>
                        <progress class="progress progress-success w-full" value="{{ nb_tout_paye }}"
                            max="{{ nb_points_eau }}"></progress>
                    </div>

                    <!-- Partiellement payé -->
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-warning font-semibold">Partiellement Payé</span>
                            <span class="badge badge-warning">{% widthratio nb_partiellement_paye nb_points_eau 100
                                %}%</span>
                        </div>
                        <progress class="progress progress-warning w-full" value="{{ nb_partiellement_paye }}"
                            max="{{ nb_points_eau }}"></progress>
                    </div>

                    <!-- Non payé -->
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="font-semibold">Non Payé</span>
                            <span class="badge badge-ghost">{% widthratio nb_non_paye nb_points_eau 100 %}%</span>
                        </div>
                        <progress class="progress w-full" value="{{ nb_non_paye }}"
                            max="{{ nb_points_eau }}"></progress>
                    </div>

                    <!-- Coupé -->
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-error font-semibold">Coupé</span>
                            <span class="badge badge-error">{% widthratio nb_coupe nb_points_eau 100 %}%</span>
                        </div>
                        <progress class="progress progress-error w-full" value="{{ nb_coupe }}"
                            max="{{ nb_points_eau }}"></progress>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ancienne stat coupé (à supprimer si pas utilisée ailleurs) -->
    <div class="hidden">
        <div class="stats shadow cursor-pointer hover:shadow-lg transition-shadow" onclick="filterByStatus('coupe')">
            <div class="stat">
                <div class="stat-figure text-error">
                    <i class="fas fa-exclamation-triangle text-3xl"></i>
                </div>
                <div class="stat-title">Coupés</div>
                <div class="stat-value text-error">{{ nb_coupe }}</div>
                <div class="stat-desc">Points d'eau</div>
            </div>
        </div>
    </div>

    <!-- Tableau consolidé par point d'eau -->
    <div class="card bg-base-100 shadow-md mb-6">
        <div class="card-body">
            <h3 class="font-bold text-lg mb-4 flex items-center justify-between">
                <div>
                    <i class="fas fa-list mr-2"></i>Points d'eau avec tarif forfaitaire
                    <span class="badge badge-primary ml-2">{{ total_lignes }} ligne{{ total_lignes|pluralize }}</span>
                    {% if page_obj.paginator.num_pages > 1 %}
                    <span class="badge badge-outline ml-2">Page {{ page_obj.number }} / {{ page_obj.paginator.num_pages
                        }}</span>
                    {% endif %}
                </div>
            </h3>
            <div class="overflow-x-auto">
                <table class="table table-sm w-full">
                    <thead>
                        <tr class="bg-base-200">
                            <th>Commune</th>
                            <th>Ouvrage</th>
                            <th>Point d'eau</th>
                            <th>Type</th>
                            <th class="text-center">1er Trimestre</th>
                            <th class="text-center">2e Trimestre</th>
                            <th class="text-center">3e Trimestre</th>
                            <th class="text-center">4e Trimestre</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for point in points_eau %}
                        <tr
                            class="hover{% if point.nouveau_ouvrage and not forloop.first %} border-t-4 border-primary{% endif %}">
                            <td>{{ point.commune }}</td>
                            <td>{{ point.ouvrage }}</td>
                            <td>{{ point.nom }}</td>
                            <td><span class="badge badge-outline badge-sm">{{ point.type_point_eau }}</span></td>

                            <!-- 1er Trimestre -->
                            <td class="text-center">
                                <div class="flex gap-1 justify-center">
                                    {% if point.T1_paye > 0 %}
                                    <span class="badge badge-success badge-sm">{{ point.T1_paye }}</span>
                                    {% endif %}
                                    {% if point.T1_non_paye > 0 %}
                                    <span class="badge badge-error badge-sm">{{ point.T1_non_paye }}</span>
                                    {% endif %}
                                    {% if point.T1_paye == 0 and point.T1_non_paye == 0 %}
                                    <span class="text-base-content/30">-</span>
                                    {% endif %}
                                </div>
                            </td>

                            <!-- 2e Trimestre -->
                            <td class="text-center">
                                <div class="flex gap-1 justify-center">
                                    {% if point.T2_paye > 0 %}
                                    <span class="badge badge-success badge-sm">{{ point.T2_paye }}</span>
                                    {% endif %}
                                    {% if point.T2_non_paye > 0 %}
                                    <span class="badge badge-error badge-sm">{{ point.T2_non_paye }}</span>
                                    {% endif %}
                                    {% if point.T2_paye == 0 and point.T2_non_paye == 0 %}
                                    <span class="text-base-content/30">-</span>
                                    {% endif %}
                                </div>
                            </td>

                            <!-- 3e Trimestre -->
                            <td class="text-center">
                                <div class="flex gap-1 justify-center">
                                    {% if point.T3_paye > 0 %}
                                    <span class="badge badge-success badge-sm">{{ point.T3_paye }}</span>
                                    {% endif %}
                                    {% if point.T3_non_paye > 0 %}
                                    <span class="badge badge-error badge-sm">{{ point.T3_non_paye }}</span>
                                    {% endif %}
                                    {% if point.T3_paye == 0 and point.T3_non_paye == 0 %}
                                    <span class="text-base-content/30">-</span>
                                    {% endif %}
                                </div>
                            </td>

                            <!-- 4e Trimestre -->
                            <td class="text-center">
                                <div class="flex gap-1 justify-center">
                                    {% if point.T4_paye > 0 %}
                                    <span class="badge badge-success badge-sm">{{ point.T4_paye }}</span>
                                    {% endif %}
                                    {% if point.T4_non_paye > 0 %}
                                    <span class="badge badge-error badge-sm">{{ point.T4_non_paye }}</span>
                                    {% endif %}
                                    {% if point.T4_paye == 0 and point.T4_non_paye == 0 %}
                                    <span class="text-base-content/30">-</span>
                                    {% endif %}
                                </div>
                            </td>

                            <td>
                                <span class="badge badge-{{ point.statut_badge }} badge-sm">
                                    <i class="fas fa-{{ point.statut_icon }} mr-1"></i>
                                    {{ point.statut_label }}
                                </span>
                                {% if point.est_coupe %}
                                <div class="text-xs text-error mt-1">
                                    <i class="fas fa-tint-slash mr-1"></i>
                                    Coupé le {{ point.date_arret|date:"d/m/Y" }}
                                </div>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{% url 'planning:gestion_forfaitaire' %}?point_eau={{ point.id }}"
                                    class="btn btn-xs btn-primary" title="Voir les détails de paiement">
                                    <i class="fas fa-eye mr-1"></i>Détails
                                </a>
                            </td>
                        </tr>
                        {% empty %}
                        <tr>
                            <td colspan="9" class="text-center text-base-content/50 py-8">
                                <i class="fas fa-inbox text-4xl mb-2"></i>
                                <p>Aucun point d'eau trouvé avec les filtres sélectionnés</p>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    {% if page_obj.paginator.num_pages > 1 %}
    <div class="flex justify-center items-center gap-2 mb-6">
        <div class="join">
            {% if page_obj.has_previous %}
            <a href="?page=1{% for key, value in request.GET.items %}{% if key != 'page' %}&{{ key }}={{ value }}{% endif %}{% endfor %}"
                class="join-item btn btn-sm">«</a>
            <a href="?page={{ page_obj.previous_page_number }}{% for key, value in request.GET.items %}{% if key != 'page' %}&{{ key }}={{ value }}{% endif %}{% endfor %}"
                class="join-item btn btn-sm">‹</a>
            {% endif %}

            <button class="join-item btn btn-sm btn-active">Page {{ page_obj.number }}</button>

            {% if page_obj.has_next %}
            <a href="?page={{ page_obj.next_page_number }}{% for key, value in request.GET.items %}{% if key != 'page' %}&{{ key }}={{ value }}{% endif %}{% endfor %}"
                class="join-item btn btn-sm">›</a>
            <a href="?page={{ page_obj.paginator.num_pages }}{% for key, value in request.GET.items %}{% if key != 'page' %}&{{ key }}={{ value }}{% endif %}{% endfor %}"
                class="join-item btn btn-sm">»</a>
            {% endif %}
        </div>
        <span class="text-sm text-base-content/70 ml-4">
            {{ page_obj.start_index }} - {{ page_obj.end_index }} sur {{ total_lignes }}
        </span>
    </div>
    {% endif %}

    <!-- Top 10 Communes - Prévu/Planifié/Payé -->
    <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title mb-4">
                <i class="fas fa-map-marked-alt mr-2 text-warning"></i>
                Top 10 Communes - Paiements
            </h2>
            <p class="text-sm text-base-content/70 mb-4">
                Comparaison des montants prévu (tarif annuel), planifié (dans les plannings) et payé (avec numéro
                DiameX)
            </p>

            <div style="position: relative; height: 400px;">
                <canvas id="communesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
    // Fonction pour filtrer par statut
    function filterByStatus(statut) {
        const url = new URL(window.location.href);
        url.searchParams.set('statut', statut);
        url.searchParams.delete('page'); // Reset à la page 1
        window.location.href = url.toString();
    }

    // Données pour le graphique
    const communesData = {{ communes_stats| safe }};

    // Graphique communes - Prévu/Planifié/Payé
    const ctxCommunes = document.getElementById('communesChart').getContext('2d');
    new Chart(ctxCommunes, {
        type: 'bar',
        data: {
            labels: communesData.map(d => d.commune),
            datasets: [
                {
                    label: 'Prévu (annuel)',
                    data: communesData.map(d => d.prevu),
                    backgroundColor: 'rgba(156, 163, 175, 0.8)',
                    borderColor: 'rgb(156, 163, 175)',
                    borderWidth: 1
                },
                {
                    label: 'Planifié',
                    data: communesData.map(d => d.planifie),
                    backgroundColor: 'rgba(59, 130, 246, 0.8)',
                    borderColor: 'rgb(59, 130, 246)',
                    borderWidth: 1
                },
                {
                    label: 'Payé',
                    data: communesData.map(d => d.paye),
                    backgroundColor: 'rgba(34, 197, 94, 0.8)',
                    borderColor: 'rgb(34, 197, 94)',
                    borderWidth: 1
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom'
                },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            return context.dataset.label + ': ' + context.parsed.y.toLocaleString() + ' Ar';
                        }
                    }
                }
            },
            scales: {
                x: {
                    ticks: {
                        maxRotation: 45,
                        minRotation: 45
                    }
                },
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function (value) {
                            return (value / 1000).toFixed(0) + 'k Ar';
                        }
                    }
                }
            }
        }
    });

    // Fonction pour changer l'année
    function changeAnnee(annee) {
        const urlParams = new URLSearchParams(window.location.search);
        urlParams.set('annee', annee);
        // Réinitialiser la pagination lors du changement d'année
        urlParams.delete('page');
        window.location.search = urlParams.toString();
    }

    // Fonction pour ouvrir la page d'impression avec communes sélectionnées
    function ouvrirImpressionAvecCommunes() {
        const selectedCommunes = Array.from(document.querySelectorAll('input[name="communes_impression"]:checked'))
            .map(cb => cb.value)
            .filter(v => v !== 'all');

        // Récupérer la version choisie
        const versionElement = document.querySelector('input[name="version_impression"]:checked');
        const version = versionElement ? versionElement.value : 'standard';

        const urlParams = new URLSearchParams(window.location.search);

        // Remplacer le filtre commune par les communes sélectionnées
        if (selectedCommunes.length > 0) {
            urlParams.set('communes', selectedCommunes.join(','));
        } else {
            urlParams.delete('communes');
        }

        // Ajouter le paramètre de version si nécessaire
        if (version === 'avec_dates') {
            urlParams.set('avec_dates', '1');
        } else {
            urlParams.delete('avec_dates');
        }

        const url = "{% url 'core:impression_paiements_forfaitaires' %}?" + urlParams.toString();
        window.open(url, '_blank', 'width=1400,height=900,toolbar=yes,scrollbars=yes');
        document.getElementById('modal_impression').close();
    }

    // Toggle sélection toutes communes
    function toggleToutesCommunes(checkbox) {
        const checkboxes = document.querySelectorAll('input[name="communes_impression"]:not([value="all"])');
        checkboxes.forEach(cb => cb.checked = checkbox.checked);
    }
</script>

<!-- Modal de sélection des communes pour impression -->
<dialog id="modal_impression" class="modal">
    <div class="modal-box max-w-2xl">
        <h3 class="font-bold text-lg mb-4">
            <i class="fas fa-print mr-2"></i>Sélectionner les communes à imprimer
        </h3>

        <!-- Choix de la version -->
        <div class="form-control mb-4 p-3 bg-base-200 rounded-lg">
            <label class="label font-semibold text-sm mb-2">Version du rapport :</label>
            <div class="flex gap-6">
                <label class="label cursor-pointer justify-start gap-2">
                    <input type="radio" name="version_impression" value="standard" class="radio radio-primary radio-sm"
                        checked>
                    <span class="label-text">Standard (Statut uniquement)</span>
                </label>
                <label class="label cursor-pointer justify-start gap-2">
                    <input type="radio" name="version_impression" value="avec_dates"
                        class="radio radio-primary radio-sm">
                    <span class="label-text">Détaillée (Avec dates de paiement)</span>
                </label>
            </div>
        </div>

        <div class="form-control mb-4">
            <label class="label cursor-pointer justify-start gap-3">
                <input type="checkbox" class="checkbox checkbox-primary" value="all"
                    onchange="toggleToutesCommunes(this)" checked>
                <span class="label-text font-semibold">Toutes les communes</span>
            </label>
        </div>

        <div class="divider my-2"></div>

        <div class="max-h-96 overflow-y-auto">
            {% regroup communes by district as communes_by_district %}
            {% for district_group in communes_by_district %}
            <div class="mb-4">
                <div class="font-bold text-sm text-primary mb-2 sticky top-0 bg-base-100 py-1">
                    <i class="fas fa-map-marker-alt mr-1"></i>{{ district_group.grouper.nom_district }}
                </div>
                <div class="grid grid-cols-2 gap-2 ml-4">
                    {% for commune in district_group.list %}
                    <div class="form-control">
                        <label class="label cursor-pointer justify-start gap-2">
                            <input type="checkbox" name="communes_impression" value="{{ commune.id }}"
                                class="checkbox checkbox-sm" checked>
                            <span class="label-text text-sm">{{ commune.nom_commune }}</span>
                        </label>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endfor %}
        </div>

        <div class="modal-action">
            <button type="button" onclick="ouvrirImpressionAvecCommunes()" class="btn btn-success">
                <i class="fas fa-print mr-2"></i>Imprimer
            </button>
            <button type="button" onclick="document.getElementById('modal_impression').close()" class="btn btn-ghost">
                Annuler
            </button>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>

{% endblock %}