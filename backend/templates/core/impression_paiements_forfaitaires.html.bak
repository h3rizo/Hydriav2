<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Paiements Forfaitaires {{ annee }} - Impression</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.4.19/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @media print {
            .no-print { display: none !important; }
            body { font-size: 9pt; }
            table { page-break-inside: auto; }
            tr { page-break-inside: avoid; page-break-after: auto; }
            thead { display: table-header-group; }
            tfoot { display: table-footer-group; }
        }
        @page {
            size: A4 landscape;
            margin: 1cm;
        }
    </style>
</head>
<body class="p-4 bg-base-100">
    <!-- Boutons d'action (masqués à l'impression) -->
    <div class="no-print mb-4 flex gap-2">
        <button onclick="window.print()" class="btn btn-primary">
            <i class="fas fa-print mr-2"></i>Imprimer
        </button>
        <button onclick="window.close()" class="btn btn-ghost">
            <i class="fas fa-times mr-2"></i>Fermer
        </button>
    </div>

    <!-- En-tête du rapport -->
    <div class="text-center mb-6">
        <h1 class="text-2xl font-bold mb-2">
            <i class="fas fa-money-bill-wave mr-2 text-primary"></i>
            Rapport des Paiements Forfaitaires {{ annee }}
        </h1>
        <div class="text-sm text-base-content/70">
            {% if commune_nom %}
                <span class="font-semibold">Commune :</span> {{ commune_nom }}
            {% endif %}
            {% if ouvrage_nom %}
                <span class="ml-4 font-semibold">Ouvrage :</span> {{ ouvrage_nom }}
            {% endif %}
            <div class="mt-1">
                <span class="font-semibold">Date d'impression :</span> {{ date_impression }}
            </div>
        </div>
    </div>

    <!-- Statistiques globales -->
    <div class="grid grid-cols-4 gap-4 mb-6">
        <div class="stat bg-base-200 rounded-lg p-3">
            <div class="stat-title text-xs">Points d'eau</div>
            <div class="stat-value text-primary text-lg">{{ nb_points_eau }}</div>
        </div>
        <div class="stat bg-base-200 rounded-lg p-3">
            <div class="stat-title text-xs">Montant prévu</div>
            <div class="stat-value text-info text-lg">{{ montant_prevu_total|floatformat:0 }} Ar</div>
        </div>
        <div class="stat bg-base-200 rounded-lg p-3">
            <div class="stat-title text-xs">Montant payé</div>
            <div class="stat-value text-success text-lg">{{ montant_paye_total|floatformat:0 }} Ar</div>
        </div>
        <div class="stat bg-base-200 rounded-lg p-3">
            <div class="stat-title text-xs">Taux de recouvrement</div>
            <div class="stat-value text-accent text-lg">{{ taux_recouvrement }}%</div>
        </div>
    </div>

    <!-- Répartition par statut -->
    <div class="grid grid-cols-4 gap-2 mb-6">
        <div class="text-center p-2 bg-success/10 rounded">
            <div class="font-bold text-success">{{ nb_tout_paye }}</div>
            <div class="text-xs">Tout payé</div>
        </div>
        <div class="text-center p-2 bg-warning/10 rounded">
            <div class="font-bold text-warning">{{ nb_partiellement_paye }}</div>
            <div class="text-xs">Partiellement payé</div>
        </div>
        <div class="text-center p-2 bg-base-200 rounded">
            <div class="font-bold">{{ nb_non_paye }}</div>
            <div class="text-xs">Non payé</div>
        </div>
        <div class="text-center p-2 bg-error/10 rounded">
            <div class="font-bold text-error">{{ nb_coupe }}</div>
            <div class="text-xs">Coupé</div>
        </div>
    </div>

    <!-- Tableau détaillé -->
    <div class="overflow-x-auto">
        <table class="table table-xs table-zebra w-full border">
            <thead class="bg-base-300">
                <tr>
                    <th class="border">Code</th>
                    <th class="border">Point d'eau</th>
                    <th class="border">Village</th>
                    <th class="border">Commune</th>
                    <th class="border">Ouvrage</th>
                    <th class="border text-right">Tarif (Ar)</th>
                    <th class="border text-center">T1</th>
                    <th class="border text-center">T2</th>
                    <th class="border text-center">T3</th>
                    <th class="border text-center">T4</th>
                    <th class="border text-right">Prévu (Ar)</th>
                    <th class="border text-right">Payé (Ar)</th>
                    <th class="border text-center">Taux</th>
                    <th class="border text-center">Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for pe in points_eau_list %}
                <tr class="text-xs">
                    <td class="border font-mono">{{ pe.code }}</td>
                    <td class="border">{{ pe.nom }}</td>
                    <td class="border text-xs">{{ pe.village }}</td>
                    <td class="border text-xs">{{ pe.commune }}</td>
                    <td class="border text-xs">{{ pe.ouvrage }}</td>
                    <td class="border text-right font-mono">{{ pe.tarif|floatformat:0 }}</td>

                    <!-- Trimestre 1 -->
                    <td class="border text-center">
                        {% if pe.trimestres.T1.paye > 0 %}
                            <span class="text-success font-bold">✓</span>
                        {% elif pe.trimestres.T1.non_paye > 0 %}
                            <span class="text-warning">○</span>
                        {% else %}
                            <span class="text-base-content/30">-</span>
                        {% endif %}
                    </td>

                    <!-- Trimestre 2 -->
                    <td class="border text-center">
                        {% if pe.trimestres.T2.paye > 0 %}
                            <span class="text-success font-bold">✓</span>
                        {% elif pe.trimestres.T2.non_paye > 0 %}
                            <span class="text-warning">○</span>
                        {% else %}
                            <span class="text-base-content/30">-</span>
                        {% endif %}
                    </td>

                    <!-- Trimestre 3 -->
                    <td class="border text-center">
                        {% if pe.trimestres.T3.paye > 0 %}
                            <span class="text-success font-bold">✓</span>
                        {% elif pe.trimestres.T3.non_paye > 0 %}
                            <span class="text-warning">○</span>
                        {% else %}
                            <span class="text-base-content/30">-</span>
                        {% endif %}
                    </td>

                    <!-- Trimestre 4 -->
                    <td class="border text-center">
                        {% if pe.trimestres.T4.paye > 0 %}
                            <span class="text-success font-bold">✓</span>
                        {% elif pe.trimestres.T4.non_paye > 0 %}
                            <span class="text-warning">○</span>
                        {% else %}
                            <span class="text-base-content/30">-</span>
                        {% endif %}
                    </td>

                    <td class="border text-right font-mono">{{ pe.montant_prevu|floatformat:0 }}</td>
                    <td class="border text-right font-mono {% if pe.montant_paye > 0 %}text-success font-semibold{% endif %}">
                        {{ pe.montant_paye|floatformat:0 }}
                    </td>
                    <td class="border text-center font-semibold">{{ pe.taux_paiement }}%</td>
                    <td class="border text-center text-xs">
                        {% if pe.statut == 'tout_paye' %}
                            <span class="text-success">Tout payé</span>
                        {% elif pe.statut == 'partiellement_paye' %}
                            <span class="text-warning">Partiel</span>
                        {% elif pe.statut == 'coupe' %}
                            <span class="text-error">Coupé</span>
                        {% else %}
                            <span class="text-base-content/70">Non payé</span>
                        {% endif %}
                    </td>
                </tr>
                {% empty %}
                <tr>
                    <td colspan="14" class="text-center py-4 text-base-content/50">
                        Aucun point d'eau trouvé pour les critères sélectionnés
                    </td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot class="bg-base-300 font-bold">
                <tr>
                    <td colspan="10" class="border text-right">TOTAL :</td>
                    <td class="border text-right font-mono">{{ montant_prevu_total|floatformat:0 }}</td>
                    <td class="border text-right font-mono text-success">{{ montant_paye_total|floatformat:0 }}</td>
                    <td class="border text-center">{{ taux_recouvrement }}%</td>
                    <td class="border"></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Légende -->
    <div class="mt-4 text-xs text-base-content/70">
        <p><strong>Légende trimestres :</strong>
            <span class="text-success font-bold ml-2">✓</span> = Payé |
            <span class="text-warning ml-2">○</span> = Non payé |
            <span class="text-base-content/30 ml-2">-</span> = Aucun paiement
        </p>
    </div>
</body>
</html>
